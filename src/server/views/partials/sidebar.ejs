<!-- Sidebar Navigation -->
<aside class="w-full md:w-64 bg-white border-r border-gray-200 flex-shrink-0 p-4 space-y-2">
  <div class="px-3 py-2 text-xs font-bold uppercase tracking-wider text-gray-400">
    Menu Utama
  </div>

  <a href="/dashboard" 
     class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors
     <%= (typeof activeMenu !== 'undefined' && activeMenu === 'dashboard') ? 'bg-blue-50 text-blue-700 font-bold' : 'text-gray-700 hover:bg-gray-100' %>">
    <span class="text-lg">📊</span>
    <span>Dashboard</span>
  </a>

  <% if (config.mode === 'bisnis') { %>
    <a href="/dashboard/products" 
       class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors
       <%= (typeof activeMenu !== 'undefined' && activeMenu === 'products') ? 'bg-blue-50 text-blue-700 font-bold' : 'text-gray-700 hover:bg-gray-100' %>">
      <span class="text-lg">📦</span>
      <span>Katalog Produk</span>
    </a>
  <% } else { %>
    <a href="/dashboard/expenses" 
       class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors
       <%= (typeof activeMenu !== 'undefined' && activeMenu === 'expenses') ? 'bg-blue-50 text-blue-700 font-bold' : 'text-gray-700 hover:bg-gray-100' %>">
      <span class="text-lg">💸</span>
      <span>Catatan Keuangan</span>
    </a>
  <% } %>

  <a href="/dashboard/chat-logs" 
     class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors
     <%= (typeof activeMenu !== 'undefined' && activeMenu === 'chat-logs') ? 'bg-blue-50 text-blue-700 font-bold' : 'text-gray-700 hover:bg-gray-100' %>">
    <span class="text-lg">💬</span>
    <span>Riwayat Chat Log</span>
  </a>

  <a href="/dashboard/settings" 
     class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors
     <%= (typeof activeMenu !== 'undefined' && activeMenu === 'settings') ? 'bg-blue-50 text-blue-700 font-bold' : 'text-gray-700 hover:bg-gray-100' %>">
    <span class="text-lg">⚙️</span>
    <span>Pengaturan Bot</span>
  </a>

  <div class="pt-4 border-t border-gray-100 px-3">
    <div class="text-xs text-gray-400 mb-2 font-semibold uppercase tracking-wider">Mode Aktif</div>
    <span class="inline-block px-2.5 py-1 rounded-full text-xs font-bold uppercase
      <%= config.mode === 'bisnis' ? 'bg-blue-100 text-blue-800' : 'bg-purple-100 text-purple-800' %>">
      Mode <%= config.mode === 'bisnis' ? 'Bisnis' : 'Personal' %>
    </span>
  </div>
</aside>
