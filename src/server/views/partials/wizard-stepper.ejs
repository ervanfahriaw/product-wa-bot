<div class="mb-8 max-w-lg mx-auto">
  <div class="flex items-center justify-between relative">
    <div class="absolute left-0 top-1/2 transform -translate-y-1/2 w-full h-[1px] bg-[#E4E4E7] -z-0"></div>
    <div class="absolute left-0 top-1/2 transform -translate-y-1/2 h-[1px] bg-[#18181B] -z-0 transition-all duration-300"
         style="width: <%= ((currentStep - 1) / 3) * 100 %>%;"></div>

    <!-- Step 1 -->
    <div class="relative z-10 flex flex-col items-center">
      <div class="w-8 h-8 rounded-full flex items-center justify-center font-medium text-xs transition-colors
        <%= currentStep >= 1 ? 'bg-[#18181B] text-white' : 'bg-[#F4F4F5] text-[#71717A] border border-[#E4E4E7]' %>">
        1
      </div>
      <span class="text-[11px] font-medium mt-1.5 <%= currentStep === 1 ? 'text-[#18181B] font-semibold' : 'text-[#71717A]' %>">
        Profil Bisnis
      </span>
    </div>

    <!-- Step 2 -->
    <div class="relative z-10 flex flex-col items-center">
      <div class="w-8 h-8 rounded-full flex items-center justify-center font-medium text-xs transition-colors
        <%= currentStep >= 2 ? 'bg-[#18181B] text-white' : 'bg-[#F4F4F5] text-[#71717A] border border-[#E4E4E7]' %>">
        2
      </div>
      <span class="text-[11px] font-medium mt-1.5 <%= currentStep === 2 ? 'text-[#18181B] font-semibold' : 'text-[#71717A]' %>">
        Scan QR
      </span>
    </div>

    <!-- Step 3 -->
    <div class="relative z-10 flex flex-col items-center">
      <div class="w-8 h-8 rounded-full flex items-center justify-center font-medium text-xs transition-colors
        <%= currentStep >= 3 ? 'bg-[#18181B] text-white' : 'bg-[#F4F4F5] text-[#71717A] border border-[#E4E4E7]' %>">
        3
      </div>
      <span class="text-[11px] font-medium mt-1.5 <%= currentStep === 3 ? 'text-[#18181B] font-semibold' : 'text-[#71717A]' %>">
        Kunci AI
      </span>
    </div>

    <!-- Step 4 -->
    <div class="relative z-10 flex flex-col items-center">
      <div class="w-8 h-8 rounded-full flex items-center justify-center font-medium text-xs transition-colors
        <%= currentStep >= 4 ? 'bg-[#18181B] text-white' : 'bg-[#F4F4F5] text-[#71717A] border border-[#E4E4E7]' %>">
        4
      </div>
      <span class="text-[11px] font-medium mt-1.5 <%= currentStep === 4 ? 'text-[#18181B] font-semibold' : 'text-[#71717A]' %>">
        Katalog Produk
      </span>
    </div>
  </div>
</div>
