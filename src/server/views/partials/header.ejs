<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'WhatsApp Bot Controller' %></title>
  
  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#2563EB',
            'primary-dark': '#1D4ED8',
            success: '#16A34A',
            danger: '#DC2626',
            surface: '#F3F4F6'
          },
          fontFamily: {
            sans: ['-apple-system', 'BlinkMacSystemFont', '"Segoe UI"', 'Roboto', 'Helvetica', 'Arial', 'sans-serif']
          }
        }
      }
    }
  </script>

  <!-- Alpine.js via CDN -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

  <style>
    [x-cloak] { display: none !important; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: #F3F4F6;
      color: #374151;
    }
  </style>
</head>
<body class="min-h-screen bg-gray-100 flex flex-col justify-between">
  <!-- Top Navigation Bar -->
  <header class="bg-white border-b border-gray-200 px-6 py-4 shadow-sm">
    <div class="max-w-6xl mx-auto flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-9 h-9 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold text-lg shadow-sm">
          🤖
        </div>
        <div>
          <h1 class="text-lg font-bold text-gray-900 leading-tight">WA Bot Assistant</h1>
          <p class="text-xs text-gray-500">Panel Kontrol & Konfigurasi Bot Lokal</p>
        </div>
      </div>

      <!-- Live Connection Badge -->
      <div x-data="liveStatus()" x-init="initPolling()" class="flex items-center space-x-2">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold"
              :class="{
                'bg-green-100 text-green-800 border border-green-200': state === 'ready',
                'bg-yellow-100 text-yellow-800 border border-yellow-200': state === 'qr_ready' || state === 'connecting' || state === 'authenticated',
                'bg-red-100 text-red-800 border border-red-200': state === 'disconnected' || state === 'auth_failure'
              }">
          <span class="w-2 h-2 rounded-full mr-1.5"
                :class="{
                  'bg-green-500': state === 'ready',
                  'bg-yellow-500 animate-ping': state === 'connecting' || state === 'qr_ready',
                  'bg-red-500': state === 'disconnected' || state === 'auth_failure'
                }"></span>
          <span x-text="statusLabel"></span>
        </span>
      </div>
    </div>
  </header>

  <script>
    function liveStatus() {
      return {
        state: 'disconnected',
        statusLabel: 'Menghubungkan...',
        initPolling() {
          this.fetchStatus();
          setInterval(() => this.fetchStatus(), 3000);
        },
        async fetchStatus() {
          try {
            const res = await fetch('/api/status');
            const data = await res.json();
            if (data.success && data.data) {
              this.state = data.data.state || 'disconnected';
              const map = {
                ready: 'Tersambung (Online)',
                qr_ready: 'Menunggu Scan QR',
                connecting: 'Menghubungkan...',
                authenticated: 'Terautentikasi',
                auth_failure: 'Gagal Sambung',
                disconnected: 'Belum Tersambung'
              };
              this.statusLabel = map[this.state] || this.state;
            }
          } catch (e) {
            this.statusLabel = 'Koneksi Server Putus';
          }
        }
      }
    }
  </script>

  <main class="flex-grow max-w-4xl w-full mx-auto px-4 py-8">
