<%- include('../partials/header') %>

<div class="max-w-xl mx-auto py-10 px-4" x-data="qrHandler()" x-init="startPolling()">
  <%- include('../partials/wizard-stepper', { currentStep: 2 }) %>

  <div class="bg-white rounded-2xl border border-[#E4E4E7] p-8 space-y-6">
    <div class="text-center space-y-1">
      <h2 class="text-xl font-bold text-[#18181B]">Tautkan Akun WhatsApp</h2>
      <p class="text-xs text-[#71717A]">Buka WhatsApp di ponsel &gt; Perangkat Tertaut &gt; Tautkan Perangkat.</p>
    </div>

    <div class="flex flex-col items-center justify-center p-6 bg-[#F7F7F8] rounded-2xl border border-[#E4E4E7] min-h-[320px]">
      <!-- State 1: Ready / Connected -->
      <template x-if="state === 'ready' || state === 'authenticated'">
        <div class="text-center space-y-4 py-4">
          <div class="w-12 h-12 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-[#18181B]">WhatsApp Berhasil Tersambung</h3>
            <p class="text-xs text-[#71717A] mt-0.5" x-text="'Akun: ' + (info?.pushname || 'User') + (info?.phone ? ' (' + info.phone + ')' : '')"></p>
          </div>
          <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-2">
            <a href="/setup/step-3" 
               class="px-5 py-2 rounded-full bg-[#18181B] hover:bg-[#27272A] text-white text-xs font-medium transition-colors">
              Lanjut ke Kunci AI
            </a>
            <button @click="resetSession()" type="button" 
                    class="px-4 py-2 rounded-full border border-[#E4E4E7] bg-white text-xs font-medium text-[#71717A] hover:text-[#18181B] transition-colors">
              Ganti Akun
            </button>
          </div>
        </div>
      </template>

      <!-- State 2: QR Ready -->
      <template x-if="state === 'qr_ready' && qrImage">
        <div class="text-center space-y-3">
          <div class="p-2 bg-white rounded-2xl border border-[#E4E4E7] inline-block">
            <img :src="qrImage" alt="QR Code WhatsApp" class="w-56 h-56 mx-auto rounded-xl">
          </div>
          <p class="text-xs text-[#71717A]">Pindai QR Code di atas menggunakan kamera WhatsApp HP Anda.</p>
        </div>
      </template>

      <!-- State 3: Connecting -->
      <template x-if="state === 'connecting'">
        <div class="text-center space-y-3 py-6">
          <div class="w-8 h-8 border-2 border-[#18181B] border-t-transparent rounded-full animate-spin mx-auto"></div>
          <p class="text-xs text-[#71717A]" x-text="loadingText"></p>
        </div>
      </template>

      <!-- State 4: Disconnected -->
      <template x-if="state === 'disconnected' || state === 'auth_failure'">
        <div class="text-center space-y-3 py-4 max-w-sm">
          <div class="w-10 h-10 bg-[#F4F4F5] text-[#71717A] rounded-full flex items-center justify-center mx-auto">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </div>
          <div>
            <h3 class="text-xs font-semibold text-[#18181B]">Menyiapkan Sesi WhatsApp</h3>
            <p class="text-[11px] text-[#71717A] mt-0.5" x-text="errorMessage || 'Sedang menghubungkan ke mesin WhatsApp...'"></p>
          </div>
          <div class="flex justify-center gap-2 pt-2">
            <button @click="initEngine()" type="button"
                    class="px-4 py-1.5 rounded-full bg-[#18181B] text-white text-xs font-medium transition-colors">
              Hubungkan Ulang
            </button>
            <button @click="resetSession()" type="button"
                    class="px-4 py-1.5 rounded-full border border-[#E4E4E7] bg-white text-xs font-medium text-[#71717A] hover:text-[#18181B] transition-colors">
              Reset Sesi
            </button>
          </div>
        </div>
      </template>
    </div>

    <div class="flex justify-between items-center pt-4 border-t border-[#E4E4E7]">
      <a href="/setup/step-1" class="text-xs font-medium text-[#71717A] hover:text-[#18181B] transition-colors">
        &larr; Kembali
      </a>
      <a href="/setup/step-3" class="px-5 py-2 rounded-full border border-[#E4E4E7] bg-white hover:bg-[#F4F4F5] text-xs font-medium text-[#18181B] transition-colors">
        Lewati &rarr;
      </a>
    </div>
  </div>
</div>

<script>
  function qrHandler() {
    return {
      state: 'connecting',
      qrImage: null,
      info: null,
      errorMessage: null,
      loadingText: 'Menyiapkan sesi WhatsApp...',
      pollInterval: null,

      startPolling() {
        this.fetchStatus();
        this.pollInterval = setInterval(() => this.fetchStatus(), 1500);
      },

      async fetchStatus() {
        try {
          const res = await fetch('/api/status');
          const data = await res.json();
          if (data.success && data.data) {
            this.state = data.data.state;
            this.qrImage = data.data.qrCodeDataUrl;
            this.info = data.data.info;
            this.errorMessage = data.data.errorMessage;
            
            if (this.state === 'connecting') {
              this.loadingText = 'Menghubungi server WhatsApp Web...';
            } else if (this.state === 'authenticated') {
              this.loadingText = 'Autentikasi berhasil, memuat data...';
            }
          }
        } catch (err) {
          this.loadingText = 'Menunggu server siap...';
        }
      },

      async initEngine() {
        this.loadingText = 'Memulai ulang WhatsApp...';
        this.state = 'connecting';
        try {
          await fetch('/api/init-engine', { method: 'POST' });
        } catch (e) {}
      },

      async resetSession() {
        this.loadingText = 'Membersihkan sesi dan membuat QR baru...';
        this.state = 'connecting';
        try {
          await fetch('/api/reset-session', { method: 'POST' });
        } catch (e) {}
      }
    }
  }
</script>

<%- include('../partials/footer') %>
