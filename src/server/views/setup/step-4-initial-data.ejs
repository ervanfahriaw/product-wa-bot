<%- include('../partials/header') %>

<div class="max-w-xl mx-auto py-10 px-4">
  <%- include('../partials/wizard-stepper', { currentStep: 4 }) %>

  <div class="bg-white rounded-2xl border border-[#E4E4E7] p-8 space-y-6">
    <div class="text-center space-y-1">
      <h2 class="text-xl font-bold text-[#18181B]">
        Masukkan Contoh Produk Pertama
      </h2>
      <p class="text-xs text-[#71717A]">
        Tambahkan satu contoh produk ke katalog agar bot bisa langsung dites untuk mengecek stok dan rekomendasi.
      </p>
    </div>

    <% if (error) { %>
      <div class="p-3.5 rounded-xl bg-red-50 border border-red-200 text-xs font-medium text-red-800">
        <%= error %>
      </div>
    <% } %>

    <form action="/setup/step-4" method="POST" class="space-y-4">
      <!-- Input Produk Bisnis -->
      <div>
        <label class="block text-xs font-medium text-[#71717A] mb-1">Nama Produk</label>
        <input type="text" name="product_name" placeholder="Contoh: Kopi Susu Gula Aren"
               class="w-full px-3.5 py-2 border border-[#E4E4E7] rounded-xl text-xs text-[#18181B] focus:outline-none focus:border-[#18181B]">
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-medium text-[#71717A] mb-1">Harga (Rp)</label>
          <input type="number" name="product_price" placeholder="18000" min="0"
                 class="w-full px-3.5 py-2 border border-[#E4E4E7] rounded-xl text-xs text-[#18181B] focus:outline-none focus:border-[#18181B]">
        </div>
        <div>
          <label class="block text-xs font-medium text-[#71717A] mb-1">Jumlah Stok</label>
          <input type="number" name="product_stock" placeholder="50" min="0"
                 class="w-full px-3.5 py-2 border border-[#E4E4E7] rounded-xl text-xs text-[#18181B] focus:outline-none focus:border-[#18181B]">
        </div>
      </div>

      <div>
        <label class="block text-xs font-medium text-[#71717A] mb-1">Deskripsi Singkat</label>
        <textarea name="product_description" rows="3" placeholder="Kopi espresso blend robusta & arabika dengan gula aren murni."
                  class="w-full px-3.5 py-2 border border-[#E4E4E7] rounded-xl text-xs text-[#18181B] focus:outline-none focus:border-[#18181B]"></textarea>
      </div>

      <div class="flex flex-col sm:flex-row justify-between items-center pt-4 border-t border-[#E4E4E7] gap-3">
        <button type="submit" formaction="/setup/step-4/skip" formmethod="POST"
                class="px-4 py-2 rounded-full border border-[#E4E4E7] bg-white hover:bg-[#F4F4F5] text-xs font-medium text-[#71717A] text-center transition-colors">
          Lewati Langkah Ini
        </button>
        <button type="submit"
                class="px-6 py-2.5 rounded-full bg-[#18181B] hover:bg-[#27272A] text-white text-xs font-medium transition-colors text-center shadow-sm">
          Selesai & Buka Dashboard Bisnis →
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
