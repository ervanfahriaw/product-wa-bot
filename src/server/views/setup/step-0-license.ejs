<%- include('../partials/header') %>

<div class="max-w-xl mx-auto py-10 px-4">
  <!-- Stepper Tahap 1 dari 5 -->
  <%- include('../partials/wizard-stepper', { currentStep: 1 }) %>

  <div class="bg-white rounded-2xl border border-[#E4E4E7] p-8 space-y-6 shadow-sm">
    
    <div class="text-center space-y-2">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold border bg-emerald-50 text-emerald-800 border-emerald-200">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>Aktivasi Lisensi Resmi</span>
      </div>
      
      <h1 class="text-2xl font-bold tracking-tight text-[#18181B]">
        Aktivasi WA Bot Bisnis AI
      </h1>
      <p class="text-xs text-[#71717A] max-w-md mx-auto">
        Masukkan kode lisensi resmi yang Anda dapatkan setelah pembelian di Lynk.id untuk mengaktifkan software bot bisnis di perangkat ini.
      </p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="p-4 rounded-xl bg-red-50 border border-red-200 text-xs font-medium text-red-800 flex items-start space-x-2">
        <svg class="w-4 h-4 text-red-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <div class="flex-1">
          <p class="font-semibold mb-0.5">Aktivasi Gagal</p>
          <p><%= error %></p>
        </div>
      </div>
    <% } %>

    <% if (typeof isLicensed !== 'undefined' && isLicensed) { %>
      <!-- Status Lisensi Sudah Aktif -->
      <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-xs text-emerald-900 space-y-2.5">
        <div class="flex items-center space-x-2">
          <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
          <span class="font-semibold">Lisensi Resmi Aktif & Terverifikasi</span>
        </div>
        <p class="text-[11px] text-emerald-800">
          Perangkat ini telah berhasil diaktivasi. Anda dapat melanjutkan wizard atau memperbarui kode lisensi di bawah jika diperlukan.
        </p>
        <div class="pt-1 flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-t border-emerald-200">
          <span class="font-mono font-semibold text-emerald-950 text-xs truncate max-w-[280px]">
            <%= licenseKey || 'WABOT-BIZ-TERAKTIVASI' %>
          </span>
          <a href="/setup/step-1" class="px-4 py-2 bg-[#18181B] hover:bg-[#27272A] text-white rounded-full font-medium text-xs text-center transition-colors shadow-sm">
            Lanjut ke Profil Bisnis →
          </a>
        </div>
      </div>
    <% } %>

    <form action="/setup/license" method="POST" class="space-y-5">
      <div>
        <label class="block text-xs font-semibold text-[#18181B] mb-1.5">
          <%= (typeof isLicensed !== 'undefined' && isLicensed) ? 'Ganti / Masukkan Lisensi Baru' : 'Kode Lisensi (License Key)' %>
        </label>
        <div class="relative">
          <input type="text" 
                 name="license_key" 
                 required 
                 placeholder="Contoh: WABOT-BIZ-XXXX-YYYY-ZZZZ"
                 value="<%= typeof licenseKey !== 'undefined' ? licenseKey : '' %>"
                 class="w-full px-4 py-2.5 uppercase font-mono text-sm border border-[#E4E4E7] rounded-xl text-[#18181B] placeholder:text-[#A1A1AA] focus:outline-none focus:border-[#18181B] transition-colors">
        </div>
        <p class="text-[11px] text-[#71717A] mt-1.5">
          Format: <span class="font-mono font-semibold">WABOT-BIZ-XXXX-YYYY-ZZZZ</span>
        </p>
      </div>

      <!-- Info Box Hardware Fingerprint -->
      <div class="p-3.5 rounded-xl bg-[#F7F7F8] border border-[#E4E4E7] text-xs space-y-1.5">
        <div class="flex justify-between items-center text-[11px]">
          <span class="text-[#71717A]">Hardware ID (HWID):</span>
          <span class="font-mono font-semibold text-[#18181B] truncate max-w-[240px]">
            <%= (typeof fingerprint !== 'undefined' && fingerprint.hwid) ? fingerprint.hwid.substring(0, 20) + '...' : 'Terdeteksi Otomatis' %>
          </span>
        </div>
        <div class="flex justify-between items-center text-[11px]">
          <span class="text-[#71717A]">Perangkat Terdeteksi:</span>
          <span class="text-[#18181B] font-medium">
            <%= (typeof fingerprint !== 'undefined' && fingerprint.deviceName) ? fingerprint.deviceName : 'Komputer Lokal' %>
          </span>
        </div>
        <p class="text-[10px] text-[#A1A1AA] pt-1 border-t border-[#E4E4E7]">
          * 1 Lisensi resmi berlaku untuk 1 perangkat utama. Anda dapat memindahkan lisensi sewaktu-waktu melalui menu Pengaturan.
        </p>
      </div>

      <!-- Optional Server URL toggle (untuk server lisensi kustom / self-hosted) -->
      <div x-data="{ showAdvanced: false }" class="pt-1">
        <button type="button" @click="showAdvanced = !showAdvanced" class="text-[11px] text-[#71717A] hover:text-[#18181B] flex items-center gap-1">
          <span x-text="showAdvanced ? '− Sembunyikan Opsi Lanjutan' : '+ Opsi Server Aktivasi Lanjutan'"></span>
        </button>
        <div x-show="showAdvanced" x-transition class="mt-2 space-y-2">
          <label class="block text-[11px] font-medium text-[#71717A]">URL Server Lisensi Kustom</label>
          <input type="url" name="server_url" placeholder="https://license.wabot.internal"
                 class="w-full px-3 py-1.5 text-xs border border-[#E4E4E7] rounded-lg text-[#18181B] focus:outline-none focus:border-[#18181B]">
        </div>
      </div>

      <div class="pt-2 flex flex-col sm:flex-row justify-between items-center gap-3">
        <% if (typeof isLicensed !== 'undefined' && isLicensed) { %>
          <a href="/setup/step-1" class="text-xs font-medium text-[#71717A] hover:text-[#18181B] transition-colors order-2 sm:order-1">
            Lewati & Lanjut ke Profil Bisnis →
          </a>
        <% } %>
        <button type="submit" 
                class="w-full sm:w-auto px-6 py-2.5 rounded-full bg-[#18181B] hover:bg-[#27272A] text-white text-xs font-semibold tracking-wide transition-all shadow-sm order-1 sm:order-2">
          Aktifkan & Lanjutkan ke Profil Bisnis →
        </button>
      </div>
    </form>

    <div class="pt-4 border-t border-[#E4E4E7] text-center">
      <p class="text-[11px] text-[#71717A]">
        Belum memiliki lisensi? Dapatkan secara resmi di <span class="font-semibold text-[#18181B]">Lynk.id</span>
      </p>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
