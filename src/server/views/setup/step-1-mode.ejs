<%- include('../partials/header') %>

<div class="max-w-xl mx-auto py-10 px-4">
  <%- include('../partials/wizard-stepper', { currentStep: 1 }) %>

  <div class="bg-white rounded-2xl border border-[#E4E4E7] p-8 space-y-6">
    
    <div class="text-center space-y-1.5">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold border bg-emerald-50 text-emerald-800 border-emerald-200">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span>WA Bot Bisnis AI</span>
      </div>
      
      <h2 class="text-xl font-bold text-[#18181B]">Profil Toko & Bisnis</h2>
      <p class="text-xs text-[#71717A] max-w-md mx-auto">Tentukan identitas bisnismu dan nomor WhatsApp pemilik untuk menerima notifikasi eskalasi pesan pelanggan.</p>
    </div>

    <% if (error) { %>
      <div class="p-3.5 rounded-xl bg-red-50 border border-red-200 text-xs font-medium text-red-800">
        <%= error %>
      </div>
    <% } %>

    <form action="/setup/step-1" method="POST" class="space-y-5">
      <!-- Mode terkunci otomatis ke Bisnis -->
      <input type="hidden" name="mode" value="bisnis">

      <!-- Form Fields untuk Bisnis -->
      <div class="space-y-4 pt-2">
        <div>
          <label class="block text-xs font-medium text-[#71717A] mb-1">Nama Brand / Toko</label>
          <input type="text" name="business_name" value="<%= config.business_name || '' %>"
                 placeholder="Contoh: Kopi Nusantara / Hijab Store" required
                 class="w-full px-3.5 py-2 border border-[#E4E4E7] rounded-xl text-xs text-[#18181B] focus:outline-none focus:border-[#18181B]">
        </div>
        <div>
          <label class="block text-xs font-medium text-[#71717A] mb-1">Nomor WhatsApp Pemilik (Untuk Notifikasi Handover)</label>
          <input type="text" name="owner_phone" value="<%= config.owner_phone || '' %>"
                 placeholder="Contoh: 628123456789" required
                 class="w-full px-3.5 py-2 border border-[#E4E4E7] rounded-xl text-xs text-[#18181B] focus:outline-none focus:border-[#18181B]">
          <p class="text-[11px] text-[#71717A] mt-1">Bot akan mengirim notifikasi ke nomor ini jika ada pelanggan yang butuh bantuan manual, komplain, atau nego khusus.</p>
        </div>
      </div>

      <div class="flex justify-end pt-2">
        <button type="submit" 
                class="w-full sm:w-auto px-6 py-2.5 rounded-full bg-[#18181B] hover:bg-[#27272A] text-white text-xs font-medium transition-colors shadow-sm">
          Simpan & Sambungkan WhatsApp →
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
