<%- include('../partials/header') %>

<%- include('../partials/wizard-stepper') %>

<div class="bg-white rounded-xl shadow-md border border-gray-200 p-8 max-w-2xl mx-auto" x-data="{ showGemini: false, showGrok: false }">
  <div class="text-center mb-8">
    <h2 class="text-2xl font-bold text-gray-900">Kunci Akses Kecerdasan Buatan (AI)</h2>
    <p class="text-sm text-gray-500 mt-2">Bot menggunakan prinsip BYOK (Bring Your Own Key) — kunci Anda disimpan secara aman di perangkat lokal.</p>
  </div>

  <% if (error) { %>
    <div class="mb-6 bg-red-50 border-l-4 border-red-500 p-4 rounded text-sm text-red-700">
      <%= error %>
    </div>
  <% } %>

  <!-- Guide Box -->
  <div class="mb-6 bg-blue-50 border border-blue-200 rounded-xl p-4 text-xs text-blue-800 space-y-2">
    <div class="font-bold flex items-center">
      <span class="mr-1.5 text-base">💡</span> Cara mendapatkan Gemini API Key gratis:
    </div>
    <ol class="list-decimal list-inside space-y-1 text-blue-700 pl-1">
      <li>Buka situs <a href="https://aistudio.google.com/app/apikey" target="_blank" class="underline font-semibold hover:text-blue-900">Google AI Studio (aistudio.google.com)</a>.</li>
      <li>Login menggunakan akun Google / Gmail Anda.</li>
      <li>Klik tombol <strong>"Create API Key"</strong> lalu salin kunci yang diberikan ke kolom di bawah.</li>
    </ol>
  </div>

  <form action="/setup/step-3" method="POST" class="space-y-6">
    <!-- Gemini API Key (Wajib) -->
    <div>
      <div class="flex justify-between items-center mb-1">
        <label class="block text-sm font-bold text-gray-800">
          Gemini API Key <span class="text-red-500">* (Wajib)</span>
        </label>
        <button type="button" @click="showGemini = !showGemini" class="text-xs text-blue-600 hover:underline" x-text="showGemini ? 'Sembunyikan' : 'Lihat'"></button>
      </div>
      <input :type="showGemini ? 'text' : 'password'"
             name="gemini_api_key"
             required
             value="<%= config.gemini_api_key || '' %>"
             placeholder="Contoh: AIzaSyD..."
             class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-500">
      <p class="text-xs text-gray-500 mt-1">Digunakan untuk memahami teks percakapan, mengecek stok, dan menyusun balasan otomatis.</p>
    </div>

    <!-- Grok Vision API Key (Opsional) -->
    <div class="pt-4 border-t border-gray-100">
      <div class="flex justify-between items-center mb-1">
        <label class="block text-sm font-bold text-gray-800">
          Grok Vision API Key <span class="text-gray-400 font-normal">(Opsional)</span>
        </label>
        <button type="button" @click="showGrok = !showGrok" class="text-xs text-blue-600 hover:underline" x-text="showGrok ? 'Sembunyikan' : 'Lihat'"></button>
      </div>
      <input :type="showGrok ? 'text' : 'password'"
             name="grok_api_key"
             value="<%= config.grok_api_key || '' %>"
             placeholder="Contoh: xai-..."
             class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-500">
      <p class="text-xs text-gray-500 mt-1">Opsional: Digunakan jika ingin bot mengenali isi gambar foto produk yang dikirim oleh pembeli.</p>
    </div>

    <div class="flex justify-between items-center pt-4 border-t border-gray-100">
      <a href="/setup/step-2" class="text-sm text-gray-500 hover:text-gray-700 font-medium">
        &larr; Kembali ke Scan QR
      </a>
      <button type="submit" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg text-sm shadow-sm transition-colors">
        Simpan & Lanjut ke Data Awal &rarr;
      </button>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
