<%- include('../partials/header') %>

<div class="max-w-xl mx-auto py-10 px-4" x-data="{ showGemini: false, showGrok: false }">
  <%- include('../partials/wizard-stepper', { currentStep: 3 }) %>

  <div class="bg-white rounded-2xl border border-[#E4E4E7] p-8 space-y-6">
    <div class="text-center space-y-1">
      <h2 class="text-xl font-bold text-[#18181B]">Kunci API Kecerdasan Buatan (AI)</h2>
      <p class="text-xs text-[#71717A]">Prinsip BYOK (Bring Your Own Key) — kunci Anda disimpan secara aman di perangkat lokal.</p>
    </div>

    <% if (error) { %>
      <div class="p-3.5 rounded-xl bg-red-50 border border-red-200 text-xs font-medium text-red-800">
        <%= error %>
      </div>
    <% } %>

    <!-- Guide Box -->
    <div class="p-4 rounded-2xl bg-[#F7F7F8] border border-[#E4E4E7] text-xs text-[#71717A] space-y-1.5">
      <p class="font-medium text-[#18181B]">Cara mendapatkan Gemini API Key gratis:</p>
      <ol class="list-decimal list-inside space-y-1 text-[11px] text-[#71717A]">
        <li>Buka <a href="https://aistudio.google.com/app/apikey" target="_blank" class="underline font-medium text-[#18181B]">Google AI Studio (aistudio.google.com)</a>.</li>
        <li>Masuk dengan akun Google Anda.</li>
        <li>Klik <strong>Create API Key</strong> dan salin kunci ke kolom di bawah.</li>
      </ol>
    </div>

    <form action="/setup/step-3" method="POST" class="space-y-5">
      <!-- Gemini API Key -->
      <div class="space-y-1.5">
        <div class="flex justify-between items-center">
          <label class="text-xs font-medium text-[#71717A]">Gemini API Key *</label>
          <button type="button" @click="showGemini = !showGemini" class="text-[11px] text-[#71717A] hover:text-[#18181B] underline" x-text="showGemini ? 'Sembunyikan' : 'Lihat'"></button>
        </div>
        <input :type="showGemini ? 'text' : 'password'"
               name="gemini_api_key"
               required
               value="<%= config.gemini_api_key || '' %>"
               placeholder="AIzaSy..."
               class="w-full px-3.5 py-2 border border-[#E4E4E7] rounded-xl text-xs font-mono text-[#18181B] focus:outline-none focus:border-[#18181B]">
        <p class="text-[11px] text-[#71717A]">Digunakan untuk memahami teks percakapan dan menghasilkan jawaban otomatis.</p>
      </div>

      <div class="flex justify-between items-center pt-4 border-t border-[#E4E4E7]">
        <a href="/setup/step-2" class="text-xs font-medium text-[#71717A] hover:text-[#18181B] transition-colors">
          &larr; Kembali
        </a>
        <button type="submit" 
                class="px-6 py-2.5 rounded-full bg-[#18181B] hover:bg-[#27272A] text-white text-xs font-medium transition-colors">
          Simpan & Lanjut
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
