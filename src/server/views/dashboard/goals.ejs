<%- include('../partials/header') %>

<div class="flex-1 flex flex-col md:flex-row min-h-screen bg-[#F7F7F8]" x-data="goalManager()">
  <%- include('../partials/sidebar', { activeMenu: 'goals', config, pendingHandoverCount }) %>

  <main class="flex-1 p-6 md:p-10 max-w-5xl bg-white md:border-r border-[#E4E4E7] min-h-screen overflow-y-auto space-y-6">
    <div class="pb-6 border-b border-[#E4E4E7] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-[#18181B]">Goal Setting</h1>
        <p class="text-xs md:text-sm text-[#71717A] mt-1">Tetapkan target & pantau progress menuju pencapaian.</p>
      </div>
      <button @click="showCreateModal = true" type="button"
              class="px-4 py-1.5 rounded-full bg-[#18181B] hover:bg-[#27272A] text-white text-xs font-medium transition-colors flex items-center space-x-1.5 self-start sm:self-auto">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
          <line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        <span>Tambah Goal</span>
      </button>
    </div>

    <div class="space-y-4">
      <% if (goals.length === 0) { %>
        <div class="text-center py-10 text-sm text-[#71717A]">Belum ada goal. Chat bot: <em>"goal: tabung 10 juta"</em></div>
      <% } else { %>
        <% goals.forEach(g => { %>
          <% const percent = g.target_value ? Math.round((g.current_value / g.target_value) * 100) : 0; %>
          <div class="p-5 rounded-2xl border border-[#E4E4E7] bg-white space-y-3">
            <div class="flex items-center justify-between">
              <div>
                <span class="text-sm font-semibold text-[#18181B]"><%= g.title %></span>
                <% if (g.status === 'completed') { %>
                  <span class="ml-2 px-2 py-0.5 text-[10px] font-bold rounded-full bg-green-50 text-green-600 inline-flex items-center gap-0.5">TERCAPAI <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg></span>
                <% } %>
              </div>
              <div class="flex items-center gap-2">
                <% if (g.status === 'active') { %>
                  <form method="POST" action="/dashboard/goals/<%= g.id %>/complete" class="inline">
                    <button type="submit" class="px-2.5 py-1 text-[10px] font-medium border border-emerald-300 rounded-full text-emerald-600 hover:bg-emerald-50 transition-colors">Selesai</button>
                  </form>
                <% } %>
                <form method="POST" action="/dashboard/goals/<%= g.id %>/delete" class="inline">
                  <button type="submit" class="px-2.5 py-1 text-[10px] font-medium border border-[#E4E4E7] rounded-full text-[#71717A] hover:text-[#DC2626] hover:border-[#DC2626] transition-colors" onclick="return confirm('Hapus goal ini?')">Hapus</button>
                </form>
              </div>
            </div>
            <% if (g.target_value) { %>
              <div class="space-y-1.5">
                <div class="flex items-center justify-between text-xs">
                  <span class="text-[#71717A]"><%= g.current_value.toLocaleString('id-ID') %> / <%= g.target_value.toLocaleString('id-ID') %> <%= g.unit || '' %></span>
                  <span class="font-semibold text-[#18181B]"><%= percent %>%</span>
                </div>
                <div class="w-full bg-[#E4E4E7] h-2 rounded-full overflow-hidden">
                  <div class="h-2 rounded-full transition-all duration-500 <%= percent >= 100 ? 'bg-emerald-500' : percent >= 60 ? 'bg-blue-500' : 'bg-[#18181B]' %>" style="width: <%= Math.min(100, percent) %>%"></div>
                </div>
              </div>
            <% } %>
            <div class="flex items-center gap-3 text-[10px] text-[#A1A1AA]">
              <% if (g.deadline) { %><span class="inline-flex items-center gap-0.5"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg> Deadline: <%= g.deadline %></span><% } %>
              <% if (g.completed_at) { %><span class="inline-flex items-center gap-0.5"><svg class="w-3 h-3 text-green-600" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg> Selesai: <%= g.completed_at %></span><% } %>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </main>
  <div class="hidden lg:block flex-1 bg-[#F7F7F8]"></div>

  <div x-show="showCreateModal" x-cloak class="fixed inset-0 bg-black/30 flex items-center justify-center z-50 p-4" @click.self="showCreateModal = false">
    <div class="bg-white rounded-2xl shadow-lg w-full max-w-md p-6 space-y-4" @click.stop>
      <h2 class="text-lg font-bold text-[#18181B]">Tambah Goal Baru</h2>
      <form method="POST" action="/dashboard/goals" class="space-y-4">
        <div><label class="text-sm font-medium text-[#18181B]">Judul Goal</label>
          <input type="text" name="title" required placeholder="Tabung 10 juta" class="w-full mt-1 px-3 py-2 text-sm border border-[#E4E4E7] rounded-xl focus:outline-none focus:border-[#7F77DD] bg-white"></div>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="text-sm font-medium text-[#18181B]">Target</label>
            <input type="number" name="target_value" placeholder="10000000" class="w-full mt-1 px-3 py-2 text-sm border border-[#E4E4E7] rounded-xl focus:outline-none focus:border-[#7F77DD] bg-white"></div>
          <div><label class="text-sm font-medium text-[#18181B]">Satuan</label>
            <input type="text" name="unit" placeholder="rupiah" class="w-full mt-1 px-3 py-2 text-sm border border-[#E4E4E7] rounded-xl focus:outline-none focus:border-[#7F77DD] bg-white"></div>
          <div><label class="text-sm font-medium text-[#18181B]">Deadline</label>
            <input type="date" name="deadline" class="w-full mt-1 px-3 py-2 text-sm border border-[#E4E4E7] rounded-xl focus:outline-none focus:border-[#7F77DD] bg-white"></div>
        </div>
        <div class="flex items-center justify-end space-x-3 pt-2">
          <button type="button" @click="showCreateModal = false" class="px-4 py-1.5 rounded-full border border-[#E4E4E7] text-xs font-medium text-[#18181B] hover:bg-[#F4F4F5] transition-colors">Batal</button>
          <button type="submit" class="px-4 py-1.5 rounded-full bg-[#18181B] hover:bg-[#27272A] text-white text-xs font-medium transition-colors">Mulai Goal</button>
        </div>
      </form>
    </div>
  </div>
</div>
<script>function goalManager() { return { showCreateModal: false }; }</script>
<%- include('../partials/footer') %>
