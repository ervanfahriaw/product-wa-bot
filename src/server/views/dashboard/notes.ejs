<%- include('../partials/header') %>

<div class="flex-1 flex flex-col md:flex-row min-h-screen bg-[#F7F7F8]" x-data="noteManager()">
  <%- include('../partials/sidebar', { activeMenu: 'notes', config, pendingHandoverCount }) %>

  <main class="flex-1 p-6 md:p-10 max-w-5xl bg-white md:border-r border-[#E4E4E7] min-h-screen overflow-y-auto space-y-6">
    <div class="pb-6 border-b border-[#E4E4E7] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-[#18181B]">Catatan</h1>
        <p class="text-xs md:text-sm text-[#71717A] mt-1">Simpan informasi penting — password, nomor resi, ide, dan lainnya.</p>
      </div>
      <button @click="showCreateModal = true" type="button"
              class="px-4 py-1.5 rounded-full bg-[#18181B] hover:bg-[#27272A] text-white text-xs font-medium transition-colors flex items-center space-x-1.5 self-start sm:self-auto">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
          <line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        <span>Tambah Catatan</span>
      </button>
    </div>

    <!-- Search -->
    <form method="GET" action="/dashboard/notes" class="flex items-center gap-3">
      <input type="text" name="q" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="Cari catatan..."
             class="flex-1 px-4 py-2 text-sm border border-[#E4E4E7] rounded-xl focus:outline-none focus:border-[#7F77DD] bg-white">
      <button type="submit" class="px-4 py-2 rounded-xl bg-[#F4F4F5] hover:bg-[#E4E4E7] text-xs font-medium text-[#18181B] transition-colors">Cari</button>
      <% if (typeof q !== 'undefined' && q) { %>
        <a href="/dashboard/notes" class="px-3 py-2 rounded-xl text-xs text-[#71717A] hover:text-[#18181B] transition-colors">Reset</a>
      <% } %>
    </form>

    <!-- Summary -->
    <div class="p-5 rounded-2xl bg-[#F7F7F8] border border-[#E4E4E7] space-y-2">
      <div class="text-xs font-medium text-[#71717A]">Total Catatan</div>
      <div class="text-2xl font-bold text-[#18181B]"><%= notes.length %></div>
      <p class="text-[11px] text-[#71717A]">catatan tersimpan</p>
    </div>

    <!-- Notes List -->
    <div class="space-y-3">
      <% if (notes.length === 0) { %>
        <div class="text-center py-10 text-sm text-[#71717A]">
          Belum ada catatan. Chat bot: <em>"catat: password wifi = rumah123"</em> atau tambah dari sini.
        </div>
      <% } else { %>
        <% notes.forEach(n => { %>
          <div class="p-4 rounded-2xl border border-[#E4E4E7] bg-white hover:bg-[#FAFAFA] transition-colors">
            <div class="flex items-start justify-between gap-3">
              <div class="flex-1 min-w-0">
                <div class="font-semibold text-sm text-[#18181B]"><%= n.title || '(tanpa judul)' %></div>
                <p class="text-xs text-[#71717A] mt-1 whitespace-pre-wrap"><%= n.content %></p>
                <div class="flex items-center gap-2 mt-2">
                  <% if (n.tags) { %>
                    <% n.tags.split(',').forEach(tag => { %>
                      <span class="px-2 py-0.5 text-[10px] font-medium rounded-full bg-[#F4F4F5] text-[#71717A]"><%= tag.trim() %></span>
                    <% }); %>
                  <% } %>
                  <span class="text-[10px] text-[#A1A1AA]"><%= n.created_at %></span>
                </div>
              </div>
              <form method="POST" action="/dashboard/notes/<%= n.id %>/delete" class="flex-shrink-0">
                <button type="submit" 
                        class="px-2.5 py-1 text-[10px] font-medium border border-[#E4E4E7] rounded-full text-[#71717A] hover:text-[#DC2626] hover:border-[#DC2626] transition-colors"
                        onclick="return confirm('Hapus catatan ini?')">
                  Hapus
                </button>
              </form>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </main>

  <div class="hidden lg:block flex-1 bg-[#F7F7F8]"></div>

  <!-- Create Modal -->
  <div x-show="showCreateModal" x-cloak class="fixed inset-0 bg-black/30 flex items-center justify-center z-50 p-4" @click.self="showCreateModal = false">
    <div class="bg-white rounded-2xl shadow-lg w-full max-w-md p-6 space-y-4" @click.stop>
      <h2 class="text-lg font-bold text-[#18181B]">Tambah Catatan Baru</h2>
      <form method="POST" action="/dashboard/notes" class="space-y-4">
        <div>
          <label class="text-sm font-medium text-[#18181B]">Judul (opsional)</label>
          <input type="text" name="title" placeholder="Password WiFi Rumah"
                 class="w-full mt-1 px-3 py-2 text-sm border border-[#E4E4E7] rounded-xl focus:outline-none focus:border-[#7F77DD] bg-white">
        </div>
        <div>
          <label class="text-sm font-medium text-[#18181B]">Isi Catatan</label>
          <textarea name="content" required rows="3" placeholder="rumah12345"
                    class="w-full mt-1 px-3 py-2 text-sm border border-[#E4E4E7] rounded-xl focus:outline-none focus:border-[#7F77DD] bg-white resize-none"></textarea>
        </div>
        <div>
          <label class="text-sm font-medium text-[#18181B]">Tags (opsional, pisahkan koma)</label>
          <input type="text" name="tags" placeholder="wifi, password, rumah"
                 class="w-full mt-1 px-3 py-2 text-sm border border-[#E4E4E7] rounded-xl focus:outline-none focus:border-[#7F77DD] bg-white">
        </div>
        <div class="flex items-center justify-end space-x-3 pt-2">
          <button type="button" @click="showCreateModal = false"
                  class="px-4 py-1.5 rounded-full border border-[#E4E4E7] text-xs font-medium text-[#18181B] hover:bg-[#F4F4F5] transition-colors">Batal</button>
          <button type="submit"
                  class="px-4 py-1.5 rounded-full bg-[#18181B] hover:bg-[#27272A] text-white text-xs font-medium transition-colors">Simpan</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function noteManager() { return { showCreateModal: false }; }
</script>

<%- include('../partials/footer') %>
