<%- include('../partials/header') %>

<div class="flex-1 flex flex-col md:flex-row min-h-screen bg-[#F7F7F8]" x-data="settingsManager()">
  <!-- Sidebar -->
  <%- include('../partials/sidebar', { activeMenu: 'settings', config, pendingHandoverCount }) %>

  <!-- Main Content Panel (Matching Reference Design) -->
  <main class="flex-1 p-6 md:p-10 max-w-4xl bg-white md:border-r border-[#E4E4E7] min-h-screen overflow-y-auto">
    <!-- Page Header -->
    <div class="pb-6 border-b border-[#E4E4E7] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-[#18181B]">Pengaturan</h1>
        <p class="text-xs md:text-sm text-[#71717A] mt-1">Konfigurasi operasional bot, koneksi WhatsApp, parameter AI, dan gaya percakapan.</p>
      </div>

      <!-- Quick Action: Status Badge -->
      <div>
        <template x-if="statusState === 'ready' || statusState === 'READY'">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-[#F4F4F5] border border-[#E4E4E7] text-[#18181B]">
            <span class="w-2 h-2 rounded-full bg-emerald-500 mr-2"></span>
            <span>Online</span>
          </span>
        </template>
        <template x-if="statusState === 'qr_ready' || statusState === 'QR_READY'">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-amber-50 border border-amber-200 text-amber-900">
            <span class="w-2 h-2 rounded-full bg-amber-500 mr-2 animate-pulse"></span>
            <span>Scan QR</span>
          </span>
        </template>
        <template x-if="statusState === 'connecting' || statusState === 'CONNECTING' || statusState === 'initializing' || statusState === 'INITIALIZING'">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-[#F4F4F5] border border-[#E4E4E7] text-[#71717A]">
            <span class="w-2 h-2 rounded-full bg-indigo-500 mr-2 animate-ping"></span>
            <span>Menghubungkan...</span>
          </span>
        </template>
        <template x-if="statusState === 'disconnected' || statusState === 'DISCONNECTED' || statusState === 'auth_failure' || statusState === 'AUTH_FAILURE'">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-red-50 border border-red-200 text-red-900">
            <span class="w-2 h-2 rounded-full bg-red-500 mr-2"></span>
            <span>Terputus</span>
          </span>
        </template>
      </div>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="mt-4 p-3.5 rounded-xl bg-[#F4F4F5] border border-[#E4E4E7] text-xs font-medium text-[#18181B] flex items-center justify-between">
        <div class="flex items-center space-x-2">
          <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span><%= success %></span>
        </div>
      </div>
    <% } %>

    <!-- 1. Perangkat WhatsApp & Scan Ulang -->
    <div class="py-6 border-b border-[#E4E4E7] space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <label class="text-sm font-semibold text-[#18181B]">Koneksi WhatsApp</label>
          <p class="text-xs text-[#71717A] mt-0.5">Tautkan akun WhatsApp bot atau ganti perangkat tanpa menghapus basis data.</p>
        </div>
        <div class="flex items-center gap-2">
          <button @click="checkStatus(true)" type="button"
                  class="px-3.5 py-1.5 rounded-full border border-[#E4E4E7] bg-white text-xs font-medium text-[#18181B] hover:bg-[#F4F4F5] transition-colors">
            Cek Status
          </button>
          <button @click="startScanModal()" type="button" :disabled="isResetting"
                  class="px-4 py-1.5 rounded-full bg-[#18181B] hover:bg-[#27272A] text-white text-xs font-medium transition-colors flex items-center space-x-1.5 disabled:opacity-50">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
              <rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect>
              <line x1="12" x2="12.01" y1="18" y2="18"></line>
            </svg>
            <span x-text="isResetting ? 'Menyiapkan...' : 'Ganti Perangkat / Scan QR'"></span>
          </button>
        </div>
      </div>

      <!-- Account Details Box -->
      <div class="p-3.5 rounded-xl bg-[#F7F7F8] border border-[#E4E4E7] text-xs space-y-1.5">
        <div class="flex justify-between">
          <span class="text-[#71717A]">Nama Akun:</span>
          <span class="font-medium text-[#18181B]" x-text="accountInfo.pushname || 'Belum terhubung'"></span>
        </div>
        <div class="flex justify-between">
          <span class="text-[#71717A]">Nomor HP Bot:</span>
          <span class="font-medium text-[#18181B]" x-text="accountInfo.phone || '-'"></span>
        </div>
      </div>
    </div>

    <!-- 1b. Informasi & Pengelolaan Lisensi Resmi -->
    <div class="py-6 border-b border-[#E4E4E7] space-y-3">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <div class="flex items-center gap-2">
            <label class="text-sm font-semibold text-[#18181B]">Status Lisensi Lynk.id</label>
            <% if (typeof licenseInfo !== 'undefined' && licenseInfo && licenseInfo.isValid) { %>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                AKTIF TERDAFTAR
              </span>
            <% } else { %>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-200">
                BELUM TERAKTIVASI
              </span>
            <% } %>
          </div>
          <p class="text-xs text-[#71717A] mt-0.5">Software resmi terikat pada identitas hardware perangkat ini.</p>
        </div>
        
        <% if (typeof licenseInfo !== 'undefined' && licenseInfo && licenseInfo.isValid) { %>
          <form action="/setup/license/deactivate" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin melepas lisensi dari perangkat ini? Bot akan terkunci hingga diaktifkan kembali.')">
            <button type="submit" 
                    class="px-3.5 py-1.5 rounded-full border border-red-200 bg-red-50 text-red-700 hover:bg-red-100 text-xs font-medium transition-colors flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
              </svg>
              <span>Pindah Perangkat / Deaktivasi</span>
            </button>
          </form>
        <% } else { %>
          <a href="/setup/license" 
             class="px-4 py-1.5 rounded-full bg-[#18181B] hover:bg-[#27272A] text-white text-xs font-medium transition-colors">
            Aktivasi Lisensi Lynk.id →
          </a>
        <% } %>
      </div>

      <div class="p-3.5 rounded-xl bg-[#F7F7F8] border border-[#E4E4E7] text-xs space-y-1.5">
        <div class="flex justify-between items-center text-[11px]">
          <span class="text-[#71717A]">Kode Lisensi:</span>
          <span class="font-mono font-bold text-[#18181B]">
            <%= (typeof licenseInfo !== 'undefined' && licenseInfo && licenseInfo.data && licenseInfo.data.licenseKey) ? licenseInfo.data.licenseKey : 'Belum Ada' %>
          </span>
        </div>
        <div class="flex justify-between items-center text-[11px]">
          <span class="text-[#71717A]">Hardware ID (HWID):</span>
          <span class="font-mono text-[#71717A] truncate max-w-[200px] sm:max-w-xs">
            <%= (typeof fingerprint !== 'undefined' && fingerprint.hwid) ? fingerprint.hwid : ((typeof licenseInfo !== 'undefined' && licenseInfo && licenseInfo.data) ? licenseInfo.data.hwid : 'Terdeteksi Otomatis') %>
          </span>
        </div>
        <div class="flex justify-between items-center text-[11px]">
          <span class="text-[#71717A]">Perangkat:</span>
          <span class="font-medium text-[#18181B]">
            <%= (typeof fingerprint !== 'undefined' && fingerprint.deviceName) ? fingerprint.deviceName : 'Komputer Lokal' %>
          </span>
        </div>
      </div>
    </div>

    <!-- Main Settings Form -->
    <form action="/dashboard/settings" method="POST" class="space-y-6 pt-2">
      <!-- 2. Mode Bot / Edition Info -->
      <div class="py-5 border-b border-[#E4E4E7] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <label class="text-sm font-semibold text-[#18181B]">Edisi & Mode Operasional</label>
          <p class="text-xs text-[#71717A] mt-0.5">Mode aktif untuk automasi penjualan & customer service WhatsApp.</p>
        </div>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold border bg-emerald-50 text-emerald-800 border-emerald-200">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>WA Bot Bisnis AI</span>
          <input type="hidden" name="mode" value="bisnis">
        </div>
      </div>

      <!-- 3. Business Name -->
      <div class="py-5 border-b border-[#E4E4E7] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <label class="text-sm font-semibold text-[#18181B]">Nama Usaha / Brand</label>
          <p class="text-xs text-[#71717A] mt-0.5">Nama bisnis yang digunakan bot saat menyapa pelanggan.</p>
        </div>
        <div class="w-full sm:w-72">
          <input type="text" name="business_name" value="<%= config.business_name || '' %>" placeholder="Contoh: Companion Coffee"
                 class="w-full px-3.5 py-2 rounded-xl border border-[#E4E4E7] bg-white text-xs text-[#18181B] focus:outline-none focus:border-[#18181B] transition-colors">
        </div>
      </div>

      <!-- 4. Owner Phone -->
      <div class="py-5 border-b border-[#E4E4E7] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <label class="text-sm font-semibold text-[#18181B]">Nomor WhatsApp Pemilik</label>
          <p class="text-xs text-[#71717A] mt-0.5">Menerima notifikasi pengalihan (handover) nego/komplain dari bot.</p>
        </div>
        <div class="w-full sm:w-72">
          <input type="text" name="owner_phone" value="<%= config.owner_phone || '' %>" placeholder="Contoh: 628123456789"
                 class="w-full px-3.5 py-2 rounded-xl border border-[#E4E4E7] bg-white text-xs text-[#18181B] focus:outline-none focus:border-[#18181B] transition-colors">
        </div>
      </div>

      <!-- 4b. Fitur Handover / Pengalihan ke Admin -->
      <div class="py-5 border-b border-[#E4E4E7] space-y-3">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <div class="flex items-center space-x-2">
              <label class="text-sm font-semibold text-[#18181B]">Fitur Handover (Pengalihan ke Admin)</label>
              <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full"
                    :class="handoverEnabled === 'true' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-zinc-100 text-zinc-600 border border-zinc-200'"
                    x-text="handoverEnabled === 'true' ? 'AKTIF' : 'NONAKTIF'"></span>
            </div>
            <p class="text-xs text-[#71717A] mt-0.5">Otomatis jeda bot dan kirim notifikasi ke nomor WhatsApp pemilik saat pelanggan menawar harga, komplain, atau meminta admin.</p>
          </div>
          <div class="w-full sm:w-72">
            <select name="handover_enabled" x-model="handoverEnabled"
                    class="w-full px-3.5 py-2 rounded-xl border border-[#E4E4E7] bg-white text-xs text-[#18181B] focus:outline-none focus:border-[#18181B] transition-colors">
              <option value="true">Aktif (Alihkan Nego/Komplain ke Admin)</option>
              <option value="false">Nonaktif (AI Jawab Sendiri 100% Tanpa Jeda)</option>
            </select>
          </div>
        </div>
        <p class="text-[11px] text-[#A1A1AA]">Saat dinonaktifkan, bot AI tidak akan menjeda obrolan atau meneruskan notifikasi, melainkan langsung menjelaskan dengan sopan bahwa harga sudah nett/pas dan melayani pelanggan secara mandiri.</p>
      </div>

      <!-- 5. Gemini API Key & Model -->
      <div class="py-5 border-b border-[#E4E4E7] space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <label class="text-sm font-semibold text-[#18181B]">Gemini API Key</label>
            <p class="text-xs text-[#71717A] mt-0.5">Kunci API bawaan Anda sendiri (BYOK) dari Google AI Studio.</p>
          </div>
          <button type="button" @click="showGemini = !showGemini" class="text-xs text-[#71717A] hover:text-[#18181B] underline self-start sm:self-auto"
                  x-text="showGemini ? 'Sembunyikan' : 'Lihat Kunci'"></button>
        </div>
        <div class="flex gap-2">
          <input :type="showGemini ? 'text' : 'password'"
                 name="gemini_api_key"
                 x-model="geminiKey"
                 required
                 placeholder="AIzaSy..."
                 class="flex-1 px-3.5 py-2 rounded-xl border border-[#E4E4E7] bg-white text-xs font-mono text-[#18181B] focus:outline-none focus:border-[#18181B] transition-colors">
          <button @click="testKey('gemini')" type="button"
                  :disabled="isTestingGemini"
                  class="px-4 py-2 rounded-full border border-[#E4E4E7] bg-white hover:bg-[#F4F4F5] text-xs font-medium text-[#18181B] transition-colors disabled:opacity-50 whitespace-nowrap">
            <span x-text="isTestingGemini ? 'Menguji...' : 'Uji Kunci'"></span>
          </button>
        </div>
        <template x-if="geminiTestResult">
          <div class="p-2.5 rounded-xl text-xs font-medium flex items-center space-x-2"
               :class="geminiTestResult.valid ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-red-50 text-red-800 border border-red-200'">
            <span x-text="geminiTestResult.valid ? 'Valid:' : 'Gagal:'"></span>
            <span x-text="geminiTestResult.message"></span>
          </div>
        </template>
      </div>

      <!-- 6. Model Selection -->
      <div class="py-5 border-b border-[#E4E4E7] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <label class="text-sm font-semibold text-[#18181B]">Model AI</label>
          <p class="text-xs text-[#71717A] mt-0.5">Pilih varian model Gemini yang digunakan untuk menghasilkan balasan.</p>
        </div>
        <div class="w-full sm:w-72">
          <select name="ai_model" x-model="aiModel"
                  class="w-full px-3.5 py-2 rounded-xl border border-[#E4E4E7] bg-white text-xs text-[#18181B] focus:outline-none focus:border-[#18181B] transition-colors">
            <option value="gemini-3.7-flash">Gemini 3.7 Flash (Direkomendasikan)</option>
            <option value="gemini-3.5-flash">Gemini 3.5 Flash (Ringan & Cepat)</option>
            <option value="gemini-3.1-pro-preview">Gemini 3.1 Pro (Penalaran Mendalam)</option>
            <option value="auto">Otomatis (Auto Fallback)</option>
          </select>
        </div>
      </div>

      <!-- 7. Tone & Style -->
      <div class="py-5 border-b border-[#E4E4E7] space-y-4">
        <div>
          <label class="text-sm font-semibold text-[#18181B]">Gaya Bahasa & Nada Bicara</label>
          <p class="text-xs text-[#71717A] mt-0.5">Sesuaikan karakter percakapan agar selaras dengan identitas brand.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <!-- Nada Bicara -->
          <div class="space-y-1.5">
            <label class="text-xs font-medium text-[#71717A]">Nada Bicara</label>
            <select name="tone_style" x-model="toneStyle"
                    class="w-full px-3 py-2 rounded-xl border border-[#E4E4E7] bg-white text-xs text-[#18181B] focus:outline-none focus:border-[#18181B]">
              <option value="ramah">Ramah & Akrab</option>
              <option value="santai">Santai (Casual)</option>
              <option value="formal">Formal & Sopan</option>
            </select>
          </div>

          <!-- Panjang Respon -->
          <div class="space-y-1.5">
            <label class="text-xs font-medium text-[#71717A]">Panjang Respon</label>
            <select name="response_length" x-model="responseLength"
                    class="w-full px-3 py-2 rounded-xl border border-[#E4E4E7] bg-white text-xs text-[#18181B] focus:outline-none focus:border-[#18181B]">
              <option value="ringkas">Ringkas</option>
              <option value="sedang">Sedang (Standar)</option>
              <option value="detail">Detail & Lengkap</option>
            </select>
          </div>

          <!-- Emoji Level -->
          <div class="space-y-1.5">
            <label class="text-xs font-medium text-[#71717A]">Intensitas Emoji</label>
            <select name="emoji_level" x-model="emojiLevel"
                    class="w-full px-3 py-2 rounded-xl border border-[#E4E4E7] bg-white text-xs text-[#18181B] focus:outline-none focus:border-[#18181B]">
              <option value="minimal">Minimal / Tanpa Emoji</option>
              <option value="wajar">Wajar (1-2 emoji)</option>
              <option value="ekspresif">Ceria & Ekspresif</option>
            </select>
          </div>
        </div>

        <!-- Max Bubbles Slider -->
        <div class="pt-2">
          <div class="flex justify-between items-center mb-1.5">
            <label class="text-xs font-medium text-[#71717A]">Maksimal Gelembung Chat Balasan</label>
            <span class="text-xs font-semibold text-[#18181B]" x-text="maxBubbles + ' Pesan'"></span>
          </div>
          <input type="range" name="max_bubbles" min="1" max="4" step="1" x-model="maxBubbles"
                 class="w-full h-1.5 bg-[#E4E4E7] rounded-lg appearance-none cursor-pointer accent-[#18181B]">
        </div>
      </div>

      <!-- 7b. Jam Operasional & Mode Luar Jam -->
      <div class="py-5 border-b border-[#E4E4E7] space-y-4">
        <div>
          <label class="text-sm font-semibold text-[#18181B]">Jam Operasional & Mode Luar Jam</label>
          <p class="text-xs text-[#71717A] mt-0.5">Atur jam buka toko dan perilaku bot saat di luar jam operasional.</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="text-xs font-medium text-[#18181B]">Jam Buka</label>
            <input type="time" name="business_hours_open" 
                   value="<%= (config.business_hours || '').split('-')[0] || '08:00' %>"
                   class="w-full mt-1 px-3 py-2 text-sm border border-[#E4E4E7] rounded-xl focus:outline-none focus:border-[#18181B] bg-white">
          </div>
          <div>
            <label class="text-xs font-medium text-[#18181B]">Jam Tutup</label>
            <input type="time" name="business_hours_close" 
                   value="<%= (config.business_hours || '').split('-')[1] || '17:00' %>"
                   class="w-full mt-1 px-3 py-2 text-sm border border-[#E4E4E7] rounded-xl focus:outline-none focus:border-[#18181B] bg-white">
          </div>
          <div>
            <label class="text-xs font-medium text-[#18181B]">Mode Luar Jam</label>
            <select name="out_of_hours_mode"
                    class="w-full mt-1 px-3 py-2 text-sm border border-[#E4E4E7] rounded-xl focus:outline-none focus:border-[#18181B] bg-white">
              <option value="off" <%= (config.out_of_hours_mode || 'off') === 'off' ? 'selected' : '' %>>Nonaktif (bot tetap jawab)</option>
              <option value="reply_only" <%= config.out_of_hours_mode === 'reply_only' ? 'selected' : '' %>>Balas Template (hemat token)</option>
              <option value="full_ai" <%= config.out_of_hours_mode === 'full_ai' ? 'selected' : '' %>>Tetap AI + Disclaimer</option>
            </select>
          </div>
        </div>
        <p class="text-[11px] text-[#A1A1AA]">Kosongkan jam jika toko buka 24 jam. Mode "Balas Template" akan mengirim pesan luar jam tanpa memanggil AI (menghemat kuota).</p>
      </div>

      <!-- 8. Timing & Debounce -->
      <div class="py-5 border-b border-[#E4E4E7] space-y-4">
        <div>
          <label class="text-sm font-semibold text-[#18181B]">Jeda Waktu & Human Pacing</label>
          <p class="text-xs text-[#71717A] mt-0.5">Mencegah deteksi spam dan mensimulasikan jeda mengetik manusia nyata.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Jeda Awal -->
          <div class="p-3.5 rounded-xl bg-[#F7F7F8] border border-[#E4E4E7] space-y-2">
            <div class="flex justify-between items-center text-xs">
              <span class="font-medium text-[#18181B]">Jeda Respon Awal</span>
              <span class="font-mono font-semibold text-[#71717A]" x-text="minDelay + 's - ' + maxDelay + 's'"></span>
            </div>
            <div class="flex items-center gap-2">
              <input type="range" name="min_delay_sec" min="2" max="20" step="1" x-model="minDelay"
                     @input="if(parseInt(minDelay) > parseInt(maxDelay)) maxDelay = minDelay"
                     class="flex-1 h-1.5 bg-[#E4E4E7] rounded-lg appearance-none cursor-pointer accent-[#18181B]">
              <input type="range" name="max_delay_sec" min="3" max="30" step="1" x-model="maxDelay"
                     @input="if(parseInt(maxDelay) < parseInt(minDelay)) minDelay = maxDelay"
                     class="flex-1 h-1.5 bg-[#E4E4E7] rounded-lg appearance-none cursor-pointer accent-[#18181B]">
            </div>
            <p class="text-[11px] text-[#71717A]">Waktu jeda acak sebelum bot mulai memproses pesan masuk.</p>
          </div>

          <!-- Jeda Antar-Bubble -->
          <div class="p-3.5 rounded-xl bg-[#F7F7F8] border border-[#E4E4E7] space-y-2">
            <div class="flex justify-between items-center text-xs">
              <span class="font-medium text-[#18181B]">Jeda Antar-Bubble</span>
              <span class="font-mono font-semibold text-[#71717A]" x-text="interBubbleDelay + ' Detik'"></span>
            </div>
            <input type="range" name="inter_bubble_delay" min="1.0" max="5.0" step="0.5" x-model="interBubbleDelay"
                   class="w-full h-1.5 bg-[#E4E4E7] rounded-lg appearance-none cursor-pointer accent-[#18181B]">
            <p class="text-[11px] text-[#71717A]">Lama status mengetik sebelum bubble berikutnya dikirim.</p>
          </div>

          <!-- Debounce Buffer Pelanggan -->
          <div class="sm:col-span-2 p-3.5 rounded-xl bg-[#F7F7F8] border border-[#E4E4E7] space-y-2">
            <div class="flex justify-between items-center text-xs">
              <span class="font-medium text-[#18181B]">Waktu Tunggu Chat Berturut-turut (Debounce)</span>
              <span class="font-mono font-semibold text-[#71717A]" x-text="customerDebounce + ' Detik'"></span>
            </div>
            <input type="range" name="customer_debounce_sec" min="1" max="15" step="1" x-model="customerDebounce"
                   class="w-full h-1.5 bg-[#E4E4E7] rounded-lg appearance-none cursor-pointer accent-[#18181B]">
            <p class="text-[11px] text-[#71717A]">Menunggu pelanggan selesai mengirim rangkaian bubble chat agar dibaca dan dibalas sekaligus.</p>
          </div>
        </div>
      </div>

      <!-- 10. Follow-Up Otomatis -->
      <div class="py-6 border-b border-[#E4E4E7] space-y-4">
        <div>
          <label class="text-sm font-semibold text-[#18181B]">Follow-Up Otomatis (Anti-Spam)</label>
          <p class="text-xs text-[#71717A] mt-0.5">Kirim pengingat sopan ke pelanggan yang bertanya tentang produk setelah selang waktu tertentu.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Toggle Aktif/Nonaktif -->
          <div>
            <label class="block text-xs font-medium text-[#71717A] mb-1.5">Aktifkan Follow-Up</label>
            <select name="follow_up_enabled" x-model="followUpEnabled"
                    class="w-full px-3.5 py-2 rounded-xl border border-[#E4E4E7] bg-white text-xs text-[#18181B] focus:outline-none focus:border-[#18181B]">
              <option value="false">Nonaktif</option>
              <option value="true">Aktif</option>
            </select>
          </div>

          <!-- Jeda Waktu (Delay) -->
          <div>
            <label class="block text-xs font-medium text-[#71717A] mb-1.5">Jeda Kirim Follow-Up (Delay)</label>
            <select name="follow_up_delay_hours" x-model="followUpDelayHours"
                    class="w-full px-3.5 py-2 rounded-xl border border-[#E4E4E7] bg-white text-xs text-[#18181B] focus:outline-none focus:border-[#18181B]">
              <option value="24">24 Jam (Direkomendasikan)</option>
              <option value="48">48 Jam</option>
              <option value="72">72 Jam</option>
            </select>
          </div>
        </div>

        <!-- Template Pesan Follow-Up -->
        <div>
          <label class="block text-xs font-medium text-[#71717A] mb-1.5">Template Pesan Follow-Up</label>
          <textarea name="follow_up_template" rows="3" x-model="followUpTemplate"
                    class="w-full px-3.5 py-2 rounded-xl border border-[#E4E4E7] bg-white text-xs text-[#18181B] focus:outline-none focus:border-[#18181B]"></textarea>
          <p class="text-[10px] text-[#A1A1AA] mt-1.5">Gunakan tag <code class="bg-[#F4F4F5] px-1 py-0.5 rounded text-[#18181B] font-mono">{product_name}</code> untuk nama produk, dan <code class="bg-[#F4F4F5] px-1 py-0.5 rounded text-[#18181B] font-mono">{business_name}</code> untuk nama usaha.</p>
        </div>

        <!-- Daftar Blacklist Opt-Out -->
        <div class="pt-4 border-t border-[#F4F4F5]">
          <h4 class="text-xs font-bold text-[#18181B] uppercase tracking-wider mb-2">Daftar Blacklist Opt-Out Pelanggan</h4>
          <p class="text-[11px] text-[#71717A] mb-3">Daftar pelanggan yang meminta tidak di-follow up lagi (menolak otomatis). Anda dapat menghapusnya jika mereka meminta bergabung kembali.</p>
          
          <div class="border border-[#E4E4E7] rounded-xl overflow-hidden bg-white text-xs max-h-48 overflow-y-auto">
            <table class="w-full text-left text-[11px]">
              <thead class="bg-[#F7F7F8] border-b border-[#E4E4E7] font-semibold text-[#71717A] whitespace-nowrap">
                <tr>
                  <th class="px-4 py-2">Kontak / Nomor WA</th>
                  <th class="px-4 py-2">Waktu Keluar (Opt-Out)</th>
                  <th class="px-4 py-2 text-right">Aksi</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#E4E4E7]">
                <% if (typeof optouts !== 'undefined' && optouts && optouts.length > 0) { %>
                  <% optouts.forEach(function(o) { %>
                    <tr class="hover:bg-[#FAFAFA]">
                      <td class="px-4 py-2 font-mono text-[#18181B] font-medium"><%= o.contact.split('@')[0] %></td>
                      <td class="px-4 py-2 text-[#71717A]"><%= new Date(o.opted_out_at).toLocaleString('id-ID') %></td>
                      <td class="px-4 py-2 text-right">
                        <form method="POST" action="/dashboard/settings/follow-ups/optout/delete" class="inline" onsubmit="return confirm('Hapus nomor ini dari daftar opt-out?')">
                          <input type="hidden" name="contact" value="<%= o.contact %>">
                          <button type="submit" class="text-red-600 hover:text-red-800 font-semibold text-[10px]">
                            Hapus
                          </button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="3" class="px-4 py-4 text-center text-[#A1A1AA] italic">Belum ada pelanggan yang opt-out.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Action Buttons (Matching Reference Save Changes Pill) -->
      <div class="pt-6 flex justify-end items-center gap-3">
        <a href="/dashboard" 
           class="px-5 py-2 rounded-full border border-[#E4E4E7] bg-white hover:bg-[#F4F4F5] text-xs font-medium text-[#18181B] transition-colors">
          Batalkan
        </a>
        <button type="submit" 
                class="px-6 py-2 rounded-full bg-[#18181B] hover:bg-[#27272A] text-white text-xs font-medium shadow-sm transition-colors">
          Simpan Perubahan
        </button>
      </div>
    </form>
  </main>

  <!-- Modal Scan QR Code (Clean & Minimalist) -->
  <div x-show="showQrModal" x-cloak class="fixed inset-0 z-50 overflow-y-auto bg-black/40 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-xl max-w-sm w-full p-6 space-y-4 text-center border border-[#E4E4E7]" @click.away="closeScanModal()">
      <div class="flex justify-between items-center pb-2 border-b border-[#E4E4E7]">
        <h3 class="text-sm font-semibold text-[#18181B]">Pindai QR Code WhatsApp</h3>
        <button @click="closeScanModal()" class="text-[#71717A] hover:text-[#18181B] text-base font-bold">&times;</button>
      </div>

      <!-- QR Display Box -->
      <div class="flex flex-col items-center justify-center min-h-[240px] bg-[#F7F7F8] rounded-xl p-4 border border-[#E4E4E7]">
        <template x-if="qrCodeDataUrl && (statusState === 'qr_ready' || statusState === 'QR_READY')">
          <div class="space-y-3">
            <img :src="qrCodeDataUrl" alt="QR Code WhatsApp" class="w-52 h-52 rounded-lg border border-[#E4E4E7] bg-white p-2 mx-auto">
            <p class="text-xs text-[#71717A]">Arahkan kamera WhatsApp smartphone ke QR Code ini</p>
          </div>
        </template>

        <template x-if="statusState === 'ready' || statusState === 'READY' || statusState === 'authenticated' || statusState === 'AUTHENTICATED'">
          <div class="space-y-2 py-6">
            <div class="w-12 h-12 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <h4 class="text-sm font-semibold text-[#18181B]">Berhasil Tersambung</h4>
            <p class="text-xs text-[#71717A]" x-text="'Akun: ' + (accountInfo.pushname || 'User')"></p>
          </div>
        </template>

        <template x-if="!(qrCodeDataUrl && (statusState === 'qr_ready' || statusState === 'QR_READY')) && statusState !== 'ready' && statusState !== 'READY' && statusState !== 'authenticated' && statusState !== 'AUTHENTICATED'">
          <div class="space-y-3 py-6">
            <div class="w-8 h-8 border-2 border-[#18181B] border-t-transparent rounded-full animate-spin mx-auto"></div>
            <p class="text-xs text-[#71717A]" x-text="modalStatusText || 'Menyiapkan sesi...'"></p>
          </div>
        </template>
      </div>

      <div class="text-left text-xs text-[#71717A] bg-[#F4F4F5] p-3 rounded-xl space-y-1">
        <p class="font-medium text-[#18181B]">Langkah Penautan:</p>
        <ol class="list-decimal list-inside space-y-0.5 text-[11px]">
          <li>Buka WhatsApp &gt; Perangkat Tertaut.</li>
          <li>Ketuk Tautkan Perangkat.</li>
          <li>Pindai QR Code di atas.</li>
        </ol>
      </div>

      <button @click="closeScanModal()" type="button" 
              class="w-full py-2 rounded-full border border-[#E4E4E7] bg-white hover:bg-[#F4F4F5] text-xs font-medium text-[#18181B] transition-colors">
        Tutup
      </button>
    </div>
  </div>
</div>

<script>
  function settingsManager() {
    return {
      mode: '<%= config.mode || "bisnis" %>',
      geminiKey: '<%= config.gemini_api_key || "" %>',
      aiModel: '<%= config.ai_model || "gemini-3.7-flash" %>',
      toneStyle: '<%= config.tone_style || "ramah" %>',
      responseLength: '<%= config.response_length || "sedang" %>',
      emojiLevel: '<%= config.emoji_level || "wajar" %>',
      maxBubbles: <%= config.max_bubbles || 3 %>,
      minDelay: <%= config.min_delay_sec || 5 %>,
      maxDelay: <%= config.max_delay_sec || 12 %>,
      interBubbleDelay: <%= config.inter_bubble_delay || 2.5 %>,
      customerDebounce: <%= config.customer_debounce_sec || 5 %>,
      handoverEnabled: '<%= config.handover_enabled === false ? "false" : "true" %>',
      followUpEnabled: '<%= config.follow_up_enabled ? "true" : "false" %>',
      followUpDelayHours: '<%= config.follow_up_delay_hours || 24 %>',
      followUpTemplate: `<%- (config.follow_up_template || "Halo Kak, kemarin sempat tanya tentang *{product_name}* ya. Varian ini masih ready lho Kak. Mau kami bantu proseskan pesanannya? 😊").replace(/`/g, "\\`").replace(/\\/g, "\\\\") %>`,
      showGemini: false,
      isTestingGemini: false,
      geminiTestResult: null,

      statusState: '<%= (typeof status !== "undefined" && status && status.state) ? status.state : "disconnected" %>',
      accountInfo: <%- JSON.stringify((typeof status !== "undefined" && status && status.info) ? status.info : {}) %>,
      qrCodeDataUrl: '<%= (typeof status !== "undefined" && status && status.qrCodeDataUrl) ? status.qrCodeDataUrl : "" %>',
      showQrModal: false,
      isResetting: false,
      modalStatusText: '',
      pollInterval: null,

      init() {
        this.checkStatus(false);
      },

      async checkStatus(manual = false) {
        try {
          const res = await fetch('/api/status');
          const json = await res.json();
          if (json.success && json.data) {
            this.statusState = (json.data.state || '').toLowerCase();
            this.accountInfo = json.data.info || {};
            this.qrCodeDataUrl = json.data.qrCodeDataUrl || '';
            if (this.qrCodeDataUrl && this.statusState === 'qr_ready') {
              this.isResetting = false;
            }
            if (manual && (this.statusState === 'ready' || this.statusState === 'authenticated')) {
              alert('Status WhatsApp: Tersambung Aktif sebagai ' + (this.accountInfo.pushname || 'User') + ' (' + (this.accountInfo.phone || '') + ')');
            }
          }
        } catch (_) {}
      },

      async startScanModal() {
        this.showQrModal = true;
        this.modalStatusText = 'Menyiapkan sesi & memuat QR Code baru...';
        await this.checkStatus(false);

        if (this.statusState !== 'qr_ready' || !this.qrCodeDataUrl) {
          this.isResetting = true;
          try {
            await fetch('/api/reset-session', { method: 'POST' });
          } catch (err) {
            console.error(err);
          } finally {
            this.isResetting = false;
          }
        }

        if (this.pollInterval) clearInterval(this.pollInterval);
        this.pollInterval = setInterval(async () => {
          await this.checkStatus(false);
          if (this.statusState === 'ready' || this.statusState === 'authenticated') {
            setTimeout(() => {
              this.closeScanModal();
            }, 1500);
          }
        }, 1200);
      },

      closeScanModal() {
        this.showQrModal = false;
        if (this.pollInterval) {
          clearInterval(this.pollInterval);
          this.pollInterval = null;
        }
      },

      async testKey(provider) {
        const apiKey = this.geminiKey;
        if (!apiKey) {
          alert('Silakan masukkan API key terlebih dahulu.');
          return;
        }

        this.isTestingGemini = true;
        try {
          const res = await fetch('/dashboard/settings/test-key', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ provider, apiKey })
          });
          const data = await res.json();
          this.geminiTestResult = { valid: data.valid, message: data.message };
        } catch (err) {
          alert('Gagal menghubungi server pengujian: ' + err.message);
        } finally {
          this.isTestingGemini = false;
        }
      }
    }
  }
</script>

<%- include('../partials/footer') %>
