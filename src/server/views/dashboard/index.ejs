<%- include('../partials/header') %>

<div class="flex flex-col md:flex-row bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden min-h-[600px]">
  <!-- Sidebar -->
  <%- include('../partials/sidebar', { activeMenu: 'dashboard', config }) %>

  <!-- Main Content Area -->
  <div class="flex-1 p-6 md:p-8 bg-gray-50 space-y-6">
    <!-- Welcome Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Panel Kontrol</h2>
        <p class="text-sm text-gray-500 mt-1">
          <%= config.mode === 'bisnis' 
              ? `Pengelolaan katalog, stok, dan layanan pelanggan WhatsApp (${config.business_name || 'Bisnis Anda'}).`
              : 'Pengelolaan keuangan pribadi, rekap pengeluaran, dan pengingat WhatsApp.' %>
        </p>
      </div>
      <a href="/setup/step-1" class="text-xs text-gray-500 hover:text-blue-600 bg-white border border-gray-200 px-3 py-1.5 rounded-lg shadow-sm font-medium self-start sm:self-auto">
        🔄 Setup Wizard
      </a>
    </div>

    <!-- Stat Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
      <!-- Card 1: WhatsApp Status -->
      <div class="bg-white rounded-xl p-5 border border-gray-200 shadow-sm">
        <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Status WhatsApp</div>
        <div class="mt-2 flex items-center space-x-2">
          <span class="w-3 h-3 rounded-full <%= status.state === 'ready' ? 'bg-green-500' : 'bg-yellow-500' %>"></span>
          <span class="text-lg font-bold text-gray-900 capitalize"><%= status.state === 'ready' ? 'Online' : status.state %></span>
        </div>
        <p class="text-xs text-gray-500 mt-1"><%= status.info?.phone ? `Nomor: +${status.info.phone}` : 'Belum discan' %></p>
      </div>

      <!-- Card 2: Main Data Metric -->
      <div class="bg-white rounded-xl p-5 border border-gray-200 shadow-sm">
        <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider">
          <%= config.mode === 'bisnis' ? 'Total Produk Aktif' : 'Total Pengeluaran Bulan Ini' %>
        </div>
        <div class="mt-2 text-2xl font-bold text-blue-600">
          <%= config.mode === 'bisnis' 
              ? `${stats.totalProducts} Produk` 
              : `Rp ${stats.totalExpenses.toLocaleString('id-ID')}` %>
        </div>
        <a href="<%= config.mode === 'bisnis' ? '/dashboard/products' : '/dashboard/expenses' %>" class="text-xs text-blue-600 hover:underline mt-1 inline-block">
          Kelola Data &rarr;
        </a>
      </div>

      <!-- Card 3: Chat Log Metric -->
      <div class="bg-white rounded-xl p-5 border border-gray-200 shadow-sm">
        <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Total Chat Terekam</div>
        <div class="mt-2 text-2xl font-bold text-gray-900">
          <%= stats.totalChatLogs %> Percakapan
        </div>
        <a href="/dashboard/chat-logs" class="text-xs text-blue-600 hover:underline mt-1 inline-block">
          Buka Chat Log &rarr;
        </a>
      </div>
    </div>

    <!-- Quick Actions Banner -->
    <div class="bg-white rounded-xl p-6 border border-gray-200 shadow-sm space-y-4">
      <h3 class="text-base font-bold text-gray-900">Aksi Cepat</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <% if (config.mode === 'bisnis') { %>
          <a href="/dashboard/products" class="p-4 rounded-lg border border-gray-200 hover:border-blue-500 hover:bg-blue-50/40 transition-all flex items-center space-x-3">
            <span class="text-2xl">➕</span>
            <div>
              <div class="font-bold text-sm text-gray-800">Tambah Produk Baru</div>
              <div class="text-xs text-gray-500">Perbarui stok atau katalog harga jualan Anda.</div>
            </div>
          </a>
        <% } else { %>
          <a href="/dashboard/expenses" class="p-4 rounded-lg border border-gray-200 hover:border-blue-500 hover:bg-blue-50/40 transition-all flex items-center space-x-3">
            <span class="text-2xl">📝</span>
            <div>
              <div class="font-bold text-sm text-gray-800">Catat Pengeluaran Manual</div>
              <div class="text-xs text-gray-500">Tambah pengeluaran tanpa melalui WhatsApp.</div>
            </div>
          </a>
        <% } %>

        <a href="/dashboard/settings" class="p-4 rounded-lg border border-gray-200 hover:border-blue-500 hover:bg-blue-50/40 transition-all flex items-center space-x-3">
          <span class="text-2xl">🔑</span>
          <div>
            <div class="font-bold text-sm text-gray-800">Pengaturan Kunci AI & Nomor Owner</div>
            <div class="text-xs text-gray-500">Uji koneksi Gemini API atau ubah nomor notifikasi.</div>
          </div>
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
