<%- include('../partials/header') %>

<div class="flex-1 flex flex-col md:flex-row min-h-screen bg-[#F7F7F8]" x-data="productManager()">
  <!-- Sidebar -->
  <%- include('../partials/sidebar', { activeMenu: 'products', config, pendingHandoverCount }) %>

  <!-- Main Content Panel -->
  <main class="flex-1 p-6 md:p-10 max-w-5xl bg-white md:border-r border-[#E4E4E7] min-h-screen overflow-y-auto space-y-6">
    <!-- Header & Action Bar -->
    <div class="pb-6 border-b border-[#E4E4E7] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-[#18181B]">Katalog Produk</h1>
        <p class="text-xs md:text-sm text-[#71717A] mt-1">Daftar produk, harga, stok, dan product knowledge yang dipelajari AI bot.</p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <button @click="showSheetsModal = true" type="button"
                class="px-3.5 py-1.5 rounded-full border border-[#E4E4E7] bg-white hover:bg-[#F4F4F5] text-xs font-medium text-[#18181B] transition-colors flex items-center space-x-1.5">
          <svg class="w-3.5 h-3.5 text-[#71717A]" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
            <rect width="18" height="18" x="3" y="3" rx="2"></rect>
            <path d="M3 9h18"></path>
            <path d="M3 15h18"></path>
            <path d="M9 3v18"></path>
            <path d="M15 3v18"></path>
          </svg>
          <span>Setup Sheets</span>
        </button>

        <button @click="syncSheets()" type="button" :disabled="isSyncing"
                class="px-3.5 py-1.5 rounded-full border border-[#E4E4E7] bg-white hover:bg-[#F4F4F5] text-xs font-medium text-[#18181B] transition-colors flex items-center space-x-1.5 disabled:opacity-50">
          <svg class="w-3.5 h-3.5 text-[#71717A]" :class="isSyncing ? 'animate-spin' : ''" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
            <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
            <path d="M3 3v5h5"></path>
            <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"></path>
            <path d="M16 16h5v5"></path>
          </svg>
          <span x-text="isSyncing ? 'Menyinkronkan...' : 'Tarik dari Sheets'"></span>
        </button>

        <button @click="openCreateModal()" type="button"
                class="px-4 py-1.5 rounded-full bg-[#18181B] hover:bg-[#27272A] text-white text-xs font-medium transition-colors flex items-center space-x-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>Tambah Produk</span>
        </button>
      </div>
    </div>

    <!-- Sync Result Banner -->
    <template x-if="syncResult">
      <div class="p-3.5 rounded-xl border text-xs font-medium flex items-center justify-between"
           :class="syncResult.success ? 'bg-emerald-50 text-emerald-800 border-emerald-200' : 'bg-red-50 text-red-800 border-red-200'">
        <div class="flex items-center space-x-2">
          <span x-text="syncResult.message"></span>
        </div>
        <button @click="syncResult = null" class="text-xs font-bold opacity-70 hover:opacity-100">&times;</button>
      </div>
    </template>

    <!-- Table Container -->
    <div class="border border-[#E4E4E7] rounded-2xl overflow-hidden bg-white">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-[#18181B]">
          <thead class="bg-[#F7F7F8] border-b border-[#E4E4E7] text-[11px] font-semibold text-[#71717A] uppercase tracking-wider">
            <tr>
              <th class="px-5 py-3.5">Foto</th>
              <th class="px-5 py-3.5">SKU & Kategori</th>
              <th class="px-5 py-3.5">Nama Produk</th>
              <th class="px-5 py-3.5">Harga</th>
              <th class="px-5 py-3.5">Stok</th>
              <th class="px-5 py-3.5">Product Knowledge</th>
              <th class="px-5 py-3.5 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#E4E4E7]">
            <% if (products && products.length > 0) { %>
              <% products.forEach(function(product) { %>
                <tr class="hover:bg-[#F7F7F8] transition-colors">
                  <td class="px-5 py-3.5 whitespace-nowrap">
                    <% if (product.image_path) { 
                         const isHttp = product.image_path.startsWith('http://') || product.image_path.startsWith('https://');
                         const cleanImg = isHttp 
                           ? product.image_path 
                           : (product.image_path.startsWith('/uploads/') 
                               ? product.image_path 
                               : '/uploads/' + product.image_path.split('\\').pop().split('/').pop());
                    %>
                      <div class="w-10 h-10 rounded-lg border border-[#E4E4E7] overflow-hidden bg-[#F4F4F5]">
                        <img src="<%= cleanImg %>" alt="<%= product.name %>" class="w-full h-full object-cover">
                      </div>
                    <% } else { %>
                      <div class="w-10 h-10 rounded-lg border border-[#E4E4E7] bg-[#F4F4F5] flex items-center justify-center text-[#A1A1AA]" title="Belum ada foto">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                          <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
                          <circle cx="9" cy="9" r="2"></circle>
                          <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
                        </svg>
                      </div>
                    <% } %>
                  </td>
                  <td class="px-5 py-3.5 whitespace-nowrap">
                    <div class="font-mono font-medium text-[#18181B]"><%= product.sku || '-' %></div>
                    <span class="inline-block mt-0.5 px-2 py-0.5 rounded text-[10px] bg-[#F4F4F5] text-[#71717A]">
                      <%= product.category || 'Umum' %>
                    </span>
                  </td>
                  <td class="px-5 py-3.5 font-medium text-[#18181B]">
                    <div><%= product.name %></div>
                    <% if (product.media_url) { %>
                      <a href="<%= product.media_url %>" target="_blank" rel="noopener noreferrer" 
                         class="inline-flex items-center space-x-1 mt-1 text-[11px] text-[#7F77DD] hover:underline font-normal">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                        </svg>
                        <span class="truncate max-w-[180px]">Link Foto/Video</span>
                      </a>
                    <% } %>
                  </td>
                  <td class="px-5 py-3.5 whitespace-nowrap text-[#18181B]">
                    Rp<%= Number(product.price).toLocaleString('id-ID') %>
                  </td>
                  <td class="px-5 py-3.5 whitespace-nowrap">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-medium
                      <%= product.stock > 0 ? 'bg-emerald-50 text-emerald-800' : 'bg-red-50 text-red-800' %>">
                      <span class="w-1.5 h-1.5 rounded-full <%= product.stock > 0 ? 'bg-emerald-500' : 'bg-red-500' %> mr-1.5"></span>
                      <%= product.stock %> unit
                    </span>
                  </td>
                  <td class="px-5 py-3.5 text-[#71717A] max-w-xs">
                    <% if (product.product_knowledge) { %>
                      <p class="text-[#18181B] font-medium line-clamp-1"><%= product.product_knowledge %></p>
                    <% } %>
                    <p class="text-[11px] text-[#A1A1AA] line-clamp-1"><%= product.description || '-' %></p>
                  </td>
                  <td class="px-5 py-3.5 text-right whitespace-nowrap space-x-2">
                    <button type="button" @click="openEditModalById(<%= product.id %>)" 
                            class="text-xs text-[#71717A] hover:text-[#18181B] font-medium transition-colors">
                      Edit
                    </button>
                    <button type="button" @click="openDeleteModalById(<%= product.id %>)" 
                            class="text-xs text-red-600 hover:text-red-800 font-medium transition-colors">
                      Hapus
                    </button>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="7" class="px-5 py-12 text-center text-[#71717A]">
                  <div class="max-w-xs mx-auto space-y-2">
                    <p class="text-sm font-semibold text-[#18181B]">Belum ada produk</p>
                    <p class="text-xs text-[#71717A]">Mulai dengan menambah produk manual atau tarik dari Google Sheets.</p>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <!-- Modal: Tambah / Edit Produk (Responsive & Non-Shifting) -->
  <div x-show="showFormModal" x-cloak 
       class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm p-2 sm:p-4 md:p-6 flex justify-center items-center"
       @click.self="showFormModal = false">
    <div class="bg-white rounded-2xl shadow-2xl max-w-xl w-full border border-[#E4E4E7] flex flex-col max-h-[92vh] overflow-hidden">
      <!-- Header Modal (Sticky) -->
      <div class="px-6 py-4 border-b border-[#E4E4E7] flex justify-between items-center bg-white flex-shrink-0">
        <div>
          <h3 class="text-base font-semibold text-[#18181B]" x-text="isEdit ? 'Edit Data Produk' : 'Tambah Produk Baru'"></h3>
          <p class="text-xs text-[#71717A] mt-0.5">Lengkapi informasi katalog produk untuk database bot WhatsApp.</p>
        </div>
        <button type="button" @click="showFormModal = false" class="text-[#71717A] hover:text-[#18181B] p-1.5 rounded-lg hover:bg-[#F4F4F5] transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <!-- Form Body (Scrollable inside card) -->
      <form id="productForm" :action="isEdit ? '/dashboard/products/' + formData.id + '/edit' : '/dashboard/products'" method="POST" enctype="multipart/form-data" @submit="handleFormSubmit($event)" class="flex flex-col flex-1 min-h-0 overflow-hidden">
        
        <div class="p-5 sm:p-6 overflow-y-auto flex-1 overscroll-contain space-y-4">
          <!-- Error Alert Banner -->
          <template x-if="formError">
            <div class="p-3.5 rounded-xl bg-red-50 border border-red-200 text-xs font-medium text-red-800 flex items-center space-x-2">
              <svg class="w-4 h-4 text-red-600 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              <span x-text="formError"></span>
            </div>
          </template>

          <!-- SKU & Kategori (2 Kolom Lebar) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-[#18181B] mb-1.5">SKU / Kode Produk</label>
              <input type="text" name="sku" x-model="formData.sku" placeholder="Contoh: FG-01"
                     class="w-full px-3.5 py-2.5 border border-[#E4E4E7] rounded-xl text-base sm:text-sm font-mono text-[#18181B] focus:outline-none focus:border-[#18181B] focus:ring-1 focus:ring-[#18181B] bg-white transition-all">
              <p class="text-[11px] text-[#71717A] mt-1">Opsional, kode unik barang.</p>
            </div>
            <div>
              <label class="block text-xs font-semibold text-[#18181B] mb-1.5">Kategori Produk</label>
              <input type="text" name="category" x-model="formData.category" placeholder="Contoh: Ikan Guppy"
                     class="w-full px-3.5 py-2.5 border border-[#E4E4E7] rounded-xl text-base sm:text-sm text-[#18181B] focus:outline-none focus:border-[#18181B] focus:ring-1 focus:ring-[#18181B] bg-white transition-all">
              <p class="text-[11px] text-[#71717A] mt-1">Default: Umum.</p>
            </div>
          </div>

          <!-- Nama Produk -->
          <div>
            <label class="block text-xs font-semibold text-[#18181B] mb-1.5">Nama Produk <span class="text-red-500">*</span></label>
            <input type="text" name="name" x-model="formData.name" placeholder="Contoh: Guppy Full Gold Champion"
                   class="w-full px-3.5 py-2.5 border border-[#E4E4E7] rounded-xl text-base sm:text-sm text-[#18181B] focus:outline-none focus:border-[#18181B] focus:ring-1 focus:ring-[#18181B] bg-white transition-all"
                   :class="nameError ? 'border-red-400 bg-red-50/30 ring-1 ring-red-400' : ''">
            <p class="text-[11px] text-[#71717A] mt-1">Nama lengkap produk yang dikenali dan dipelajari AI bot.</p>
          </div>

          <!-- Harga & Stok -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-[#18181B] mb-1.5">Harga (Rp)</label>
              <input type="text" name="price" x-model="formData.price" placeholder="Contoh: 857000"
                     @input="formData.price = $el.value.replace(/[^0-9]/g, '')"
                     class="w-full px-3.5 py-2.5 border border-[#E4E4E7] rounded-xl text-base sm:text-sm text-[#18181B] focus:outline-none focus:border-[#18181B] focus:ring-1 focus:ring-[#18181B] bg-white transition-all">
              <p class="text-[11px] text-[#71717A] mt-1">Masukkan angka tanpa titik/koma (default: 0).</p>
            </div>
            <div>
              <label class="block text-xs font-semibold text-[#18181B] mb-1.5">Jumlah Stok</label>
              <input type="text" name="stock" x-model="formData.stock" placeholder="Contoh: 10"
                     @input="formData.stock = $el.value.replace(/[^0-9]/g, '')"
                     class="w-full px-3.5 py-2.5 border border-[#E4E4E7] rounded-xl text-base sm:text-sm text-[#18181B] focus:outline-none focus:border-[#18181B] focus:ring-1 focus:ring-[#18181B] bg-white transition-all">
              <p class="text-[11px] text-[#71717A] mt-1">Unit ready (bot cek stok saat customer tanya).</p>
            </div>
          </div>

          <!-- Upload Foto Produk -->
          <div>
            <label class="block text-xs font-semibold text-[#18181B] mb-1.5">Foto Utama Produk</label>
            <div class="flex items-center space-x-3 p-3.5 border border-[#E4E4E7] rounded-xl bg-[#FAFAFA]">
              <template x-if="imagePreview || formData.image_path">
                <div class="relative w-14 h-14 rounded-lg border border-[#E4E4E7] overflow-hidden bg-white flex-shrink-0">
                  <img :src="getImageSrc()" class="w-full h-full object-cover" alt="Preview">
                </div>
              </template>
              <div class="flex-1">
                <input type="file" name="image" accept="image/*"
                       @change="handleImageChange($event)"
                       class="w-full text-xs text-[#71717A] file:mr-2.5 file:py-1.5 file:px-3 file:rounded-full file:border-0 file:text-xs file:font-medium file:bg-[#18181B] file:text-white hover:file:bg-[#27272A] cursor-pointer">
                <input type="hidden" name="image_path" :value="formData.image_path || ''">
                <p class="text-[11px] text-[#71717A] mt-1">Format JPG, PNG, atau WEBP. Foto ini dikirim otomatis ke WA saat pembeli minta gambar produk.</p>
              </div>
            </div>
          </div>

          <!-- Link Kumpulan Foto & Video (Google Drive / Cloud / dll) -->
          <div>
            <label class="block text-xs font-semibold text-[#18181B] mb-1.5">Link Galeri Lengkap (Google Drive / Cloud / Video)</label>
            <input type="text" name="media_url" x-model="formData.media_url" placeholder="https://drive.google.com/drive/folders/... atau drive.google.com/..."
                   class="w-full px-3.5 py-2.5 border border-[#E4E4E7] rounded-xl text-base sm:text-sm text-[#18181B] focus:outline-none focus:border-[#18181B] focus:ring-1 focus:ring-[#18181B] bg-white transition-all">
            <p class="text-[11px] text-[#71717A] mt-1">Opsional: Tautan folder kumpulan foto/video. Link ini otomatis disertakan pada caption foto saat customer meminta foto di WhatsApp.</p>
          </div>

          <!-- Detail Bahan / Knowledge -->
          <div>
            <label class="block text-xs font-semibold text-[#18181B] mb-1.5">Product Knowledge / Detail Spesifikasi</label>
            <textarea name="product_knowledge" rows="2" x-model="formData.product_knowledge"
                      placeholder="Contoh: Grade A kontes, warna pekat mengkilap, ekor lebar rapi, indukan pilihan..."
                      class="w-full px-3.5 py-2.5 border border-[#E4E4E7] rounded-xl text-base sm:text-sm text-[#18181B] focus:outline-none focus:border-[#18181B] focus:ring-1 focus:ring-[#18181B] bg-white transition-all"></textarea>
            <p class="text-[11px] text-[#71717A] mt-1">Pengetahuan khusus yang dipelajari AI untuk menjawab pertanyaan detail pelanggan.</p>
          </div>

          <!-- Deskripsi Singkat -->
          <div>
            <label class="block text-xs font-semibold text-[#18181B] mb-1.5">Deskripsi Singkat</label>
            <textarea name="description" rows="2" x-model="formData.description" placeholder="Keterangan singkat produk..."
                      class="w-full px-3.5 py-2.5 border border-[#E4E4E7] rounded-xl text-base sm:text-sm text-[#18181B] focus:outline-none focus:border-[#18181B] focus:ring-1 focus:ring-[#18181B] bg-white transition-all"></textarea>
          </div>

          <!-- Rekomendasi Produk Terkait (Upselling) -->
          <div>
            <label class="block text-xs font-semibold text-[#18181B] mb-1.5">Rekomendasi Produk Terkait (Upselling)</label>
            <div class="border border-[#E4E4E7] rounded-xl p-3 max-h-36 overflow-y-auto space-y-1.5 bg-[#FAFAFA]">
              <template x-for="p in getAvailableRelatedProducts()" :key="p.id">
                <label class="flex items-center space-x-2.5 text-xs text-[#18181B] cursor-pointer hover:bg-white p-1 rounded-lg transition-colors">
                  <input type="checkbox" 
                         :value="p.id"
                         :checked="isRelatedChecked(p.id)"
                         @change="toggleRelated(p.id, $event.target.checked)"
                         class="rounded border-[#E4E4E7] text-[#18181B] focus:ring-0">
                  <span class="truncate" x-text="p.name + (p.sku ? ' (' + p.sku + ')' : '')"></span>
                </label>
              </template>
              <template x-if="getAvailableRelatedProducts().length === 0">
                <p class="text-xs text-[#71717A] text-center py-2">Belum ada produk lain untuk direkomendasikan.</p>
              </template>
            </div>
            <input type="hidden" name="related_products" :value="formData.related_products || ''">
          </div>
        </div>

        <!-- Footer Modal (Sticky at Bottom) -->
        <div class="px-6 py-3.5 border-t border-[#E4E4E7] bg-[#FAFAFA] flex justify-end items-center gap-3 flex-shrink-0">
          <button type="button" @click="showFormModal = false" :disabled="isSubmitting"
                  class="px-4 py-2 rounded-full border border-[#E4E4E7] bg-white hover:bg-[#F4F4F5] text-xs font-medium text-[#18181B] transition-colors disabled:opacity-50">
            Batal
          </button>
          <button type="submit" :disabled="isSubmitting"
                  class="px-6 py-2 rounded-full bg-[#18181B] hover:bg-[#27272A] text-white text-xs font-medium transition-colors flex items-center space-x-2 disabled:opacity-50 shadow-sm">
            <template x-if="isSubmitting">
              <svg class="animate-spin w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </template>
            <span x-text="isSubmitting ? 'Menyimpan...' : (isEdit ? 'Simpan Perubahan' : 'Simpan Produk Baru')"></span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Google Sheets Config -->
  <div x-show="showSheetsModal" x-cloak class="fixed inset-0 z-50 overflow-y-auto bg-black/40 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-xl max-w-md w-full p-6 space-y-4 border border-[#E4E4E7]" @click.away="showSheetsModal = false">
      <div class="flex justify-between items-center pb-2 border-b border-[#E4E4E7]">
        <h3 class="text-sm font-semibold text-[#18181B]">Integrasi Google Sheets</h3>
        <button @click="showSheetsModal = false" class="text-[#71717A] hover:text-[#18181B] text-base font-bold">&times;</button>
      </div>

      <form action="/dashboard/products/sheets-config" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-[#71717A] mb-1">URL Google Spreadsheet *</label>
          <input type="url" name="sheets_url" value="<%= config.sheets_url || '' %>" required
                 placeholder="https://docs.google.com/spreadsheets/d/..."
                 class="w-full px-3 py-2 border border-[#E4E4E7] rounded-xl text-xs text-[#18181B] focus:outline-none focus:border-[#18181B]">
          <p class="text-[11px] text-[#71717A] mt-1">Pastikan setelan spreadsheet di Google Drive adalah <strong>Siapa saja dengan link dapat melihat</strong>.</p>
        </div>

        <div class="bg-[#F7F7F8] p-3 rounded-xl border border-[#E4E4E7] text-xs text-[#71717A] space-y-1">
          <p class="font-medium text-[#18181B]">Format Kolom Header Spreadsheet:</p>
          <p class="font-mono text-[10px] bg-white p-2 rounded-lg border border-[#E4E4E7] text-[#18181B]">
            SKU | Nama Produk | Kategori | Harga | Stok | Link Gambar | Deskripsi | Product Knowledge
          </p>
        </div>

        <div class="space-y-2 pt-2 border-t border-[#E4E4E7]">
          <label class="flex items-center space-x-2 cursor-pointer">
            <input type="checkbox" name="sheets_auto_sync" value="1" <%= config.sheets_auto_sync ? 'checked' : '' %> class="rounded text-[#18181B]">
            <span class="text-xs font-medium text-[#18181B]">Aktifkan Sinkronisasi Otomatis</span>
          </label>

          <div class="flex items-center space-x-2 pl-6">
            <span class="text-xs text-[#71717A]">Interval:</span>
            <input type="number" name="sheets_sync_interval" value="<%= config.sheets_sync_interval || 10 %>" min="1" max="60"
                   class="w-16 px-2 py-1 border border-[#E4E4E7] rounded-lg text-xs text-center text-[#18181B] focus:outline-none">
            <span class="text-xs text-[#71717A]">Menit</span>
          </div>
        </div>

        <div class="flex justify-end items-center gap-2 pt-3 border-t border-[#E4E4E7]">
          <button @click="showSheetsModal = false" type="button" 
                  class="px-4 py-1.5 rounded-full border border-[#E4E4E7] bg-white hover:bg-[#F4F4F5] text-xs font-medium text-[#18181B]">
            Batal
          </button>
          <button type="submit" 
                  class="px-5 py-1.5 rounded-full bg-[#18181B] hover:bg-[#27272A] text-white text-xs font-medium">
            Simpan Konfigurasi
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Konfirmasi Hapus Produk -->
  <div x-show="showDeleteModal" x-cloak 
       class="fixed inset-0 z-50 overflow-y-auto bg-black/60 backdrop-blur-sm flex items-center justify-center p-4" 
       @click.self="showDeleteModal = false">
    <div class="bg-white rounded-2xl shadow-xl max-w-xs w-full p-6 space-y-4 text-center border border-[#E4E4E7]">
      <div class="w-10 h-10 rounded-full bg-red-100 text-red-600 flex items-center justify-center mx-auto">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-[#18181B]">Hapus Produk?</h3>
        <p class="text-xs text-[#71717A] mt-1">Produk <span class="font-medium text-[#18181B]" x-text="deleteName"></span> akan dihapus dari katalog.</p>
      </div>
      <form :action="'/dashboard/products/' + deleteId + '/delete'" method="POST" class="flex justify-center gap-2 pt-2">
        <button @click="showDeleteModal = false" type="button" 
                class="px-4 py-1.5 rounded-full border border-[#E4E4E7] bg-white hover:bg-[#F4F4F5] text-xs font-medium text-[#18181B]">
          Batal
        </button>
        <button type="submit" 
                class="px-4 py-1.5 rounded-full bg-red-600 hover:bg-red-700 text-white text-xs font-medium">
          Hapus
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  const rawProductsData = <%- JSON.stringify(products.map(p => ({
    id: p.id,
    sku: p.sku || '',
    name: p.name || '',
    category: p.category || 'Umum',
    price: p.price || 0,
    stock: p.stock || 0,
    description: p.description || '',
    product_knowledge: p.product_knowledge || '',
    image_path: p.image_path || '',
    media_url: p.media_url || '',
    related_products: p.related_products || ''
  }))).replace(/</g, '\\u003c') %>;

  function productManager() {
    return {
      productsList: rawProductsData,
      showFormModal: false,
      showDeleteModal: false,
      showSheetsModal: false,
      isEdit: false,
      isSyncing: false,
      isSubmitting: false,
      formError: null,
      nameError: false,
      syncResult: null,
      deleteId: null,
      deleteName: '',
      formData: {
        id: null,
        sku: '',
        name: '',
        category: 'Umum',
        price: '0',
        stock: '10',
        description: '',
        product_knowledge: '',
        image_path: '',
        media_url: '',
        related_products: ''
      },

      imagePreview: null,
      handleImageChange(e) {
        if (e.target.files && e.target.files[0]) {
          this.imagePreview = URL.createObjectURL(e.target.files[0]);
        }
      },

      getImageSrc() {
        if (this.imagePreview) return this.imagePreview;
        const p = this.formData.image_path || '';
        if (!p) return '';
        if (p.startsWith('http://') || p.startsWith('https://')) return p;
        if (p.startsWith('/uploads/')) return p;
        const fn = p.split('\\').pop().split('/').pop();
        return '/uploads/' + fn;
      },

      openCreateModal() {
        this.isEdit = false;
        this.isSubmitting = false;
        this.formError = null;
        this.nameError = false;
        this.imagePreview = null;
        this.formData = {
          id: null,
          sku: '',
          name: '',
          category: 'Umum',
          price: '0',
          stock: '10',
          description: '',
          product_knowledge: '',
          image_path: '',
          media_url: '',
          related_products: ''
        };
        this.showFormModal = true;
      },

      openEditModalById(id) {
        const prod = this.productsList.find(p => p.id === id);
        if (!prod) return;
        this.isEdit = true;
        this.isSubmitting = false;
        this.formError = null;
        this.nameError = false;
        this.imagePreview = null;
        this.formData = {
          id: prod.id,
          sku: prod.sku || '',
          name: prod.name || '',
          category: prod.category || 'Umum',
          price: String(prod.price || 0),
          stock: String(prod.stock || 0),
          description: prod.description || '',
          product_knowledge: prod.product_knowledge || '',
          image_path: prod.image_path || '',
          media_url: prod.media_url || '',
          related_products: prod.related_products || ''
        };
        this.showFormModal = true;
      },

      openDeleteModalById(id) {
        const prod = this.productsList.find(p => p.id === id);
        this.deleteId = id;
        this.deleteName = prod ? prod.name : '';
        this.showDeleteModal = true;
      },

      getAvailableRelatedProducts() {
        return this.productsList.filter(p => !this.formData.id || p.id !== this.formData.id);
      },

      isRelatedChecked(id) {
        if (!this.formData.related_products) return false;
        const arr = String(this.formData.related_products).split(',').filter(Boolean);
        return arr.includes(String(id));
      },

      toggleRelated(id, checked) {
        let arr = this.formData.related_products ? String(this.formData.related_products).split(',').filter(Boolean) : [];
        const strId = String(id);
        if (checked) {
          if (!arr.includes(strId)) arr.push(strId);
        } else {
          arr = arr.filter(item => item !== strId);
        }
        this.formData.related_products = arr.join(',');
      },

      async handleFormSubmit(e) {
        e.preventDefault();
        this.formError = null;
        this.nameError = false;

        // 1. Validasi Nama Produk
        if (!this.formData.name || !this.formData.name.trim()) {
          this.formError = 'Nama produk wajib diisi sebelum menyimpan.';
          this.nameError = true;
          return;
        }

        // 2. Normalisasi Harga & Stok (jika kosong, set 0)
        let cleanPrice = parseInt(String(this.formData.price || '').replace(/[^0-9]/g, ''), 10);
        if (isNaN(cleanPrice) || cleanPrice < 0) cleanPrice = 0;
        this.formData.price = String(cleanPrice);

        let cleanStock = parseInt(String(this.formData.stock || '').replace(/[^0-9]/g, ''), 10);
        if (isNaN(cleanStock) || cleanStock < 0) cleanStock = 0;
        this.formData.stock = String(cleanStock);

        // 3. Normalisasi Media URL (auto-prepend https:// jika pengguna tidak mengetik protokol)
        if (this.formData.media_url && this.formData.media_url.trim()) {
          let trimmedUrl = this.formData.media_url.trim();
          if (!trimmedUrl.startsWith('http://') && !trimmedUrl.startsWith('https://')) {
            this.formData.media_url = 'https://' + trimmedUrl;
          }
        }

        this.isSubmitting = true;

        try {
          const formElement = e.target;
          const formDataObj = new FormData(formElement);
          if (this.formData.media_url) {
            formDataObj.set('media_url', this.formData.media_url);
          }
          formDataObj.set('price', this.formData.price);
          formDataObj.set('stock', this.formData.stock);

          const response = await fetch(formElement.action, {
            method: 'POST',
            body: formDataObj,
            headers: {
              'Accept': 'application/json'
            }
          });

          if (!response.ok) {
            let errorMsg = 'Terjadi kesalahan saat menyimpan data (status ' + response.status + ')';
            try {
              const resData = await response.json();
              if (resData && resData.message) errorMsg = resData.message;
            } catch (_) {}
            throw new Error(errorMsg);
          }

          window.location.reload();
        } catch (err) {
          console.error('[Product Submit Error]', err);
          this.formError = err.message || 'Gagal menyimpan produk. Silakan coba lagi.';
          this.isSubmitting = false;
        }
      },

      async syncSheets() {
        this.isSyncing = true;
        this.syncResult = null;
        try {
          const res = await fetch('/dashboard/products/sync-sheets', { method: 'POST' });
          const data = await res.json();
          this.syncResult = data;
          if (data.success) {
            setTimeout(() => window.location.reload(), 1200);
          }
        } catch (err) {
          this.syncResult = { success: false, message: 'Gagal menghubungi server: ' + err.message };
        } finally {
          this.isSyncing = false;
        }
      }
    };
  }
</script>

<%- include('../partials/footer') %>
