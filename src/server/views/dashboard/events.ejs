<%- include('../partials/header') %>

<div class="flex-1 flex flex-col md:flex-row min-h-screen bg-[#F7F7F8]" x-data="eventManager()">
  <%- include('../partials/sidebar', { activeMenu: 'events', config, pendingHandoverCount }) %>

  <main class="flex-1 p-6 md:p-10 max-w-5xl bg-white md:border-r border-[#E4E4E7] min-h-screen overflow-y-auto space-y-6">
    <div class="pb-6 border-b border-[#E4E4E7] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-[#18181B]">Jadwal Acara</h1>
        <p class="text-xs md:text-sm text-[#71717A] mt-1">Kelola jadwal meeting, appointment, dan acara penting.</p>
      </div>
      <button @click="showCreateModal = true" type="button"
              class="px-4 py-1.5 rounded-full bg-[#18181B] hover:bg-[#27272A] text-white text-xs font-medium transition-colors flex items-center space-x-1.5 self-start sm:self-auto">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
          <line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        <span>Tambah Jadwal</span>
      </button>
    </div>

    <div class="space-y-3">
      <% if (events.length === 0) { %>
        <div class="text-center py-10 text-sm text-[#71717A]">Belum ada jadwal mendatang.</div>
      <% } else { %>
        <% events.forEach(e => { %>
          <div class="p-4 rounded-2xl border border-[#E4E4E7] bg-white hover:bg-[#FAFAFA] transition-colors flex items-start justify-between gap-3">
            <div class="flex-1 min-w-0">
              <div class="font-semibold text-sm text-[#18181B]"><%= e.title %></div>
              <div class="text-xs text-[#71717A] mt-1 inline-flex items-center gap-0.5"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg> <%= e.event_date %></div>
              <% if (e.location) { %><div class="text-xs text-[#71717A] inline-flex items-center gap-0.5"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg> <%= e.location %></div><% } %>
              <% if (e.description) { %><div class="text-xs text-[#A1A1AA] mt-1"><%= e.description %></div><% } %>
            </div>
            <form method="POST" action="/dashboard/events/<%= e.id %>/delete" class="flex-shrink-0">
              <button type="submit" class="px-2.5 py-1 text-[10px] font-medium border border-[#E4E4E7] rounded-full text-[#71717A] hover:text-[#DC2626] hover:border-[#DC2626] transition-colors" onclick="return confirm('Hapus jadwal ini?')">Hapus</button>
            </form>
          </div>
        <% }); %>
      <% } %>
    </div>
  </main>
  <div class="hidden lg:block flex-1 bg-[#F7F7F8]"></div>

  <div x-show="showCreateModal" x-cloak class="fixed inset-0 bg-black/30 flex items-center justify-center z-50 p-4" @click.self="showCreateModal = false">
    <div class="bg-white rounded-2xl shadow-lg w-full max-w-md p-6 space-y-4" @click.stop>
      <h2 class="text-lg font-bold text-[#18181B]">Tambah Jadwal Baru</h2>
      <form method="POST" action="/dashboard/events" class="space-y-4">
        <div><label class="text-sm font-medium text-[#18181B]">Judul Acara</label>
          <input type="text" name="title" required placeholder="Meeting Zoom" class="w-full mt-1 px-3 py-2 text-sm border border-[#E4E4E7] rounded-xl focus:outline-none focus:border-[#7F77DD] bg-white"></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="text-sm font-medium text-[#18181B]">Tanggal & Jam</label>
            <input type="datetime-local" name="event_date" required class="w-full mt-1 px-3 py-2 text-sm border border-[#E4E4E7] rounded-xl focus:outline-none focus:border-[#7F77DD] bg-white"></div>
          <div><label class="text-sm font-medium text-[#18181B]">Lokasi (opsional)</label>
            <input type="text" name="location" placeholder="Zoom / Kantor" class="w-full mt-1 px-3 py-2 text-sm border border-[#E4E4E7] rounded-xl focus:outline-none focus:border-[#7F77DD] bg-white"></div>
        </div>
        <div><label class="text-sm font-medium text-[#18181B]">Deskripsi (opsional)</label>
          <textarea name="description" rows="2" placeholder="Catatan tambahan..." class="w-full mt-1 px-3 py-2 text-sm border border-[#E4E4E7] rounded-xl focus:outline-none focus:border-[#7F77DD] bg-white resize-none"></textarea></div>
        <div class="flex items-center justify-end space-x-3 pt-2">
          <button type="button" @click="showCreateModal = false" class="px-4 py-1.5 rounded-full border border-[#E4E4E7] text-xs font-medium text-[#18181B] hover:bg-[#F4F4F5] transition-colors">Batal</button>
          <button type="submit" class="px-4 py-1.5 rounded-full bg-[#18181B] hover:bg-[#27272A] text-white text-xs font-medium transition-colors">Simpan</button>
        </div>
      </form>
    </div>
  </div>
</div>
<script>function eventManager() { return { showCreateModal: false }; }</script>
<%- include('../partials/footer') %>
