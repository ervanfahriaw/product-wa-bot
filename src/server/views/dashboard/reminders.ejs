<%- include('../partials/header') %>

<div class="flex-1 flex flex-col md:flex-row min-h-screen bg-[#F7F7F8]" x-data="reminderManager()">
  <!-- Sidebar -->
  <%- include('../partials/sidebar', { activeMenu: 'reminders', config, pendingHandoverCount }) %>

  <!-- Main Content Panel -->
  <main class="flex-1 p-6 md:p-10 max-w-5xl bg-white md:border-r border-[#E4E4E7] min-h-screen overflow-y-auto space-y-6">
    <!-- Header & Actions -->
    <div class="pb-6 border-b border-[#E4E4E7] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-[#18181B]">Pengingat</h1>
        <p class="text-xs md:text-sm text-[#71717A] mt-1">Kelola pengingat otomatis — satu kali maupun berulang (harian, mingguan, bulanan).</p>
      </div>

      <button @click="openCreateModal()" type="button"
              class="px-4 py-1.5 rounded-full bg-[#18181B] hover:bg-[#27272A] text-white text-xs font-medium transition-colors flex items-center space-x-1.5 self-start sm:self-auto">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        <span>Tambah Pengingat</span>
      </button>
    </div>

    <!-- Summary Metrics -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="p-5 rounded-2xl bg-[#F7F7F8] border border-[#E4E4E7] space-y-2">
        <div class="text-xs font-medium text-[#71717A]">Total Aktif</div>
        <div class="text-2xl font-bold text-[#18181B]"><%= activeCount %></div>
        <p class="text-[11px] text-[#71717A]">pengingat yang sedang berjalan</p>
      </div>
      <div class="p-5 rounded-2xl bg-[#F7F7F8] border border-[#E4E4E7] space-y-2">
        <div class="text-xs font-medium text-[#71717A]">Berulang</div>
        <div class="text-2xl font-bold text-[#18181B]"><%= recurringCount %></div>
        <p class="text-[11px] text-[#71717A]">harian, mingguan, atau bulanan</p>
      </div>
      <div class="p-5 rounded-2xl bg-[#F7F7F8] border border-[#E4E4E7] space-y-2">
        <div class="text-xs font-medium text-[#71717A]">Satu Kali</div>
        <div class="text-2xl font-bold text-[#18181B]"><%= oneshotCount %></div>
        <p class="text-[11px] text-[#71717A]">belum terkirim</p>
      </div>
    </div>

    <!-- Reminders Table -->
    <div class="border border-[#E4E4E7] rounded-2xl overflow-hidden bg-white">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-[#18181B]">
          <thead class="bg-[#F7F7F8] border-b border-[#E4E4E7] text-[11px] font-semibold text-[#71717A] uppercase tracking-wider">
            <tr>
              <th class="px-4 py-3">Pesan</th>
              <th class="px-4 py-3">Waktu Berikutnya</th>
              <th class="px-4 py-3">Jenis</th>
              <th class="px-4 py-3">Status</th>
              <th class="px-4 py-3 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (reminders.length === 0) { %>
              <tr>
                <td colspan="5" class="px-4 py-10 text-center text-sm text-[#71717A]">
                  Belum ada pengingat. Tambah pengingat baru atau chat bot: <em>"ingatkan besok jam 8 pagi bayar BPJS"</em>
                </td>
              </tr>
            <% } else { %>
              <% reminders.forEach(r => { %>
                <tr class="border-t border-[#E4E4E7] hover:bg-[#FAFAFA] transition-colors">
                  <td class="px-4 py-3">
                    <div class="font-medium text-[#18181B] max-w-[200px] truncate"><%= r.message %></div>
                    <% if (r.label && r.label !== r.message.toLowerCase().substring(0, 100)) { %>
                      <div class="text-[10px] text-[#A1A1AA] mt-0.5">Label: <%= r.label %></div>
                    <% } %>
                  </td>
                  <td class="px-4 py-3 text-[#71717A]">
                    <%= r.trigger_at %>
                    <% if (r.snoozed_until) { %>
                      <div class="text-[10px] text-orange-500 mt-0.5 inline-flex items-center gap-0.5"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>Ditunda s/d <%= r.snoozed_until %></div>
                    <% } %>
                  </td>
                  <td class="px-4 py-3">
                    <% if (r.recurrence_type) { %>
                      <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-[#7F77DD]/10 text-[#3C3489]">
                        <svg class="w-3 h-3 inline-block" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg> <%= r.recurrence_type === 'daily' ? 'Harian' : r.recurrence_type === 'weekly' ? 'Mingguan' : 'Bulanan' %>
                      </span>
                    <% } else { %>
                      <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-[#F4F4F5] text-[#71717A]">
                        <svg class="w-3 h-3 inline-block" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg> Satu Kali
                      </span>
                    <% } %>
                  </td>
                  <td class="px-4 py-3">
                    <% if (!r.is_active) { %>
                      <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-red-50 text-red-600">Dibatalkan</span>
                    <% } else if (r.sent && !r.recurrence_type) { %>
                      <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-green-50 text-green-600">Terkirim</span>
                    <% } else { %>
                      <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-blue-50 text-blue-600">Aktif</span>
                    <% } %>
                  </td>
                  <td class="px-4 py-3 text-right">
                    <div class="flex items-center justify-end space-x-2">
                      <% if (r.is_active && (!r.sent || r.recurrence_type)) { %>
                        <form method="POST" action="/dashboard/reminders/<%= r.id %>/cancel" class="inline">
                          <button type="submit" 
                                  class="px-2.5 py-1 text-[10px] font-medium border border-[#E4E4E7] rounded-full text-[#71717A] hover:text-[#DC2626] hover:border-[#DC2626] transition-colors"
                                  onclick="return confirm('Batalkan pengingat ini?')">
                            Batalkan
                          </button>
                        </form>
                      <% } %>
                      <form method="POST" action="/dashboard/reminders/<%= r.id %>/delete" class="inline">
                        <button type="submit" 
                                class="px-2.5 py-1 text-[10px] font-medium border border-[#E4E4E7] rounded-full text-[#71717A] hover:text-[#DC2626] hover:border-[#DC2626] transition-colors"
                                onclick="return confirm('Hapus pengingat ini secara permanen?')">
                          Hapus
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <!-- Right-side empty (minimalist) -->
  <div class="hidden lg:block flex-1 bg-[#F7F7F8]"></div>

  <!-- Create Reminder Modal -->
  <div x-show="showCreateModal" x-cloak
       class="fixed inset-0 bg-black/30 flex items-center justify-center z-50 p-4"
       @click.self="showCreateModal = false">
    <div class="bg-white rounded-2xl shadow-lg w-full max-w-md p-6 space-y-4" @click.stop>
      <h2 class="text-lg font-bold text-[#18181B]">Tambah Pengingat Baru</h2>
      <form method="POST" action="/dashboard/reminders" class="space-y-4">
        <div>
          <label class="text-sm font-medium text-[#18181B]">Pesan Pengingat</label>
          <input type="text" name="message" required placeholder="Bayar listrik"
                 class="w-full mt-1 px-3 py-2 text-sm border border-[#E4E4E7] rounded-xl focus:outline-none focus:border-[#7F77DD] bg-white">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="text-sm font-medium text-[#18181B]">Tanggal</label>
            <input type="date" name="trigger_date" required
                   class="w-full mt-1 px-3 py-2 text-sm border border-[#E4E4E7] rounded-xl focus:outline-none focus:border-[#7F77DD] bg-white">
          </div>
          <div>
            <label class="text-sm font-medium text-[#18181B]">Jam</label>
            <input type="time" name="trigger_time" required value="08:00"
                   class="w-full mt-1 px-3 py-2 text-sm border border-[#E4E4E7] rounded-xl focus:outline-none focus:border-[#7F77DD] bg-white">
          </div>
        </div>
        <div>
          <label class="text-sm font-medium text-[#18181B]">Jenis</label>
          <select name="recurrence_type"
                  class="w-full mt-1 px-3 py-2 text-sm border border-[#E4E4E7] rounded-xl focus:outline-none focus:border-[#7F77DD] bg-white">
            <option value="">Satu Kali</option>
            <option value="daily">Harian (Setiap Hari)</option>
            <option value="weekly">Mingguan (Setiap Minggu)</option>
            <option value="monthly">Bulanan (Setiap Bulan)</option>
          </select>
        </div>
        <div class="flex items-center justify-end space-x-3 pt-2">
          <button type="button" @click="showCreateModal = false"
                  class="px-4 py-1.5 rounded-full border border-[#E4E4E7] text-xs font-medium text-[#18181B] hover:bg-[#F4F4F5] transition-colors">
            Batal
          </button>
          <button type="submit"
                  class="px-4 py-1.5 rounded-full bg-[#18181B] hover:bg-[#27272A] text-white text-xs font-medium transition-colors">
            Simpan Pengingat
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function reminderManager() {
  return {
    showCreateModal: false,
    openCreateModal() {
      this.showCreateModal = true;
    }
  };
}
</script>

<%- include('../partials/footer') %>
