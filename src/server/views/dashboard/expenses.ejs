<%- include('../partials/header') %>

<div class="flex flex-col md:flex-row bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden min-h-[600px]"
     x-data="expenseManager()">
  <!-- Sidebar -->
  <%- include('../partials/sidebar', { activeMenu: 'expenses', config }) %>

  <!-- Main Content Area -->
  <div class="flex-1 p-6 md:p-8 bg-gray-50 space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Catatan Keuangan & Pengeluaran</h2>
        <p class="text-sm text-gray-500 mt-1">Daftar pencatatan pengeluaran harian yang dicatat secara otomatis via chat WhatsApp atau dimasukkan secara manual.</p>
      </div>
      <button @click="openCreateModal()" type="button"
              class="px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg text-sm shadow-sm transition-colors flex items-center space-x-2">
        <span>➕</span>
        <span>Catat Pengeluaran</span>
      </button>
    </div>

    <!-- Metric Summary -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
        <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Total Seluruh Pengeluaran</div>
        <div class="mt-2 text-2xl font-bold text-gray-900">
          Rp<%= totalAmount.toLocaleString('id-ID') %>
        </div>
        <p class="text-xs text-gray-500 mt-1"><%= expenses.length %> transaksi tercatat</p>
      </div>
      <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
        <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Pengeluaran Bulan Ini</div>
        <div class="mt-2 text-2xl font-bold text-blue-600">
          Rp<%= thisMonthTotal.toLocaleString('id-ID') %>
        </div>
        <p class="text-xs text-gray-500 mt-1">Bulan berjalan</p>
      </div>
    </div>

    <!-- Expenses Table Card -->
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-gray-600">
          <thead class="bg-gray-50 border-b border-gray-200 text-xs font-bold text-gray-500 uppercase">
            <tr>
              <th class="px-5 py-3.5">Tanggal</th>
              <th class="px-5 py-3.5">Kategori</th>
              <th class="px-5 py-3.5">Nominal</th>
              <th class="px-5 py-3.5">Catatan</th>
              <th class="px-5 py-3.5 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% if (expenses && expenses.length > 0) { %>
              <% expenses.forEach(function(expense) { %>
                <tr class="hover:bg-gray-50/80 transition-colors">
                  <td class="px-5 py-4 text-xs font-mono text-gray-500">
                    <%= expense.created_at.substring(0, 10) %>
                  </td>
                  <td class="px-5 py-4">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-800">
                      <%= expense.category %>
                    </span>
                  </td>
                  <td class="px-5 py-4 font-bold text-gray-900">
                    Rp<%= Number(expense.amount).toLocaleString('id-ID') %>
                  </td>
                  <td class="px-5 py-4 text-xs text-gray-600 max-w-xs truncate">
                    <%= expense.note || '-' %>
                  </td>
                  <td class="px-5 py-4 text-right space-x-2">
                    <button @click="openEditModal(<%= JSON.stringify(expense) %>)" 
                            class="text-xs text-blue-600 hover:text-blue-800 font-semibold">
                      Edit
                    </button>
                    <button @click="openDeleteModal(<%= expense.id %>, '<%= expense.category %>', <%= expense.amount %>)" 
                            class="text-xs text-red-600 hover:text-red-800 font-semibold">
                      Hapus
                    </button>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="5" class="px-5 py-8 text-center text-gray-400 text-sm">
                  Belum ada catatan pengeluaran. Anda bisa mencatat langsung via chat WhatsApp (contoh: "beli kopi 25rb") atau klik tombol di atas.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Modal: Tambah / Edit Pengeluaran -->
  <div x-show="showFormModal" x-cloak class="fixed inset-0 z-50 overflow-y-auto bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6 space-y-4" @click.away="showFormModal = false">
      <div class="flex justify-between items-center pb-2 border-b border-gray-100">
        <h3 class="text-lg font-bold text-gray-900" x-text="isEdit ? 'Edit Pengeluaran' : 'Catat Pengeluaran Baru'"></h3>
        <button @click="showFormModal = false" class="text-gray-400 hover:text-gray-600 text-xl font-bold">&times;</button>
      </div>

      <form :action="isEdit ? '/dashboard/expenses/' + formData.id + '/edit' : '/dashboard/expenses'" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Kategori *</label>
          <input type="text" name="category" required x-model="formData.category" placeholder="Makan & Minum, Transportasi, Belanja..."
                 class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
        </div>

        <div>
          <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Nominal (Rp) *</label>
          <input type="number" name="amount" required min="1" x-model="formData.amount" placeholder="25000"
                 class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
        </div>

        <div>
          <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Catatan Keterangan</label>
          <input type="text" name="note" x-model="formData.note" placeholder="Makan siang nasi padang..."
                 class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
        </div>

        <div class="flex justify-end space-x-2 pt-3 border-t border-gray-100">
          <button @click="showFormModal = false" type="button" class="px-4 py-2 text-sm text-gray-600 hover:bg-gray-100 rounded-lg">
            Batal
          </button>
          <button type="submit" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-lg shadow-sm">
            Simpan Pengeluaran
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Konfirmasi Hapus Pengeluaran -->
  <div x-show="showDeleteModal" x-cloak class="fixed inset-0 z-50 overflow-y-auto bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-sm w-full p-6 space-y-4" @click.away="showDeleteModal = false">
      <div class="w-12 h-12 rounded-full bg-red-100 text-red-600 flex items-center justify-center mx-auto text-2xl font-bold">
        ⚠️
      </div>
      <div class="text-center">
        <h3 class="text-base font-bold text-gray-900">Konfirmasi Hapus Pengeluaran</h3>
        <p class="text-xs text-gray-500 mt-1">Hapus catatan <span class="font-bold text-gray-800" x-text="deleteCategory + ' (Rp' + deleteAmount + ')'"></span>?</p>
      </div>
      <form :action="'/dashboard/expenses/' + deleteId + '/delete'" method="POST" class="flex justify-center space-x-3 pt-2">
        <button @click="showDeleteModal = false" type="button" class="px-4 py-2 text-xs font-semibold text-gray-600 hover:bg-gray-100 rounded-lg">
          Batal
        </button>
        <button type="submit" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-xs font-semibold rounded-lg shadow-sm">
          Ya, Hapus
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  function expenseManager() {
    return {
      showFormModal: false,
      showDeleteModal: false,
      isEdit: false,
      deleteId: null,
      deleteCategory: '',
      deleteAmount: 0,
      formData: {
        id: null,
        category: '',
        amount: '',
        note: ''
      },

      openCreateModal() {
        this.isEdit = false;
        this.formData = { id: null, category: '', amount: '', note: '' };
        this.showFormModal = true;
      },

      openEditModal(expense) {
        this.isEdit = true;
        this.formData = { ...expense };
        this.showFormModal = true;
      },

      openDeleteModal(id, category, amount) {
        this.deleteId = id;
        this.deleteCategory = category;
        this.deleteAmount = Number(amount).toLocaleString('id-ID');
        this.showDeleteModal = true;
      }
    }
  }
</script>

<%- include('../partials/footer') %>
