<%- include('../partials/header') %>

<div class="flex flex-col md:flex-row bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden min-h-[600px]"
     x-data="{ showClearModal: false }">
  <!-- Sidebar -->
  <%- include('../partials/sidebar', { activeMenu: 'chat-logs', config }) %>

  <!-- Main Content Area -->
  <div class="flex-1 p-6 md:p-8 bg-gray-50 space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Riwayat Percakapan (Chat Log)</h2>
        <p class="text-sm text-gray-500 mt-1">Audit seluruh interaksi pesan masuk dari pelanggan/pengguna dan balasan yang dikirim oleh bot maupun admin.</p>
      </div>
      <% if (logs && logs.length > 0) { %>
        <button @click="showClearModal = true" type="button"
                class="px-4 py-2 bg-red-50 hover:bg-red-100 text-red-600 font-semibold rounded-lg text-xs transition-colors border border-red-200 self-start sm:self-auto">
          🗑️ Kosongkan Riwayat
        </button>
      <% } %>
    </div>

    <!-- Search / Filter Bar -->
    <form action="/dashboard/chat-logs" method="GET" class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm flex flex-col sm:flex-row gap-3">
      <input type="text" name="contact" value="<%= filterContact || '' %>" placeholder="Cari berdasarkan nomor kontak (cth: 62812...)"
             class="flex-1 px-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
      <button type="submit" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg text-sm shadow-sm transition-colors">
        🔍 Filter
      </button>
      <% if (filterContact) { %>
        <a href="/dashboard/chat-logs" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-600 font-medium rounded-lg text-sm text-center">
          Reset
        </a>
      <% } %>
    </form>

    <!-- Chat Logs Table Card -->
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-gray-600">
          <thead class="bg-gray-50 border-b border-gray-200 text-xs font-bold text-gray-500 uppercase">
            <tr>
              <th class="px-5 py-3.5">Waktu</th>
              <th class="px-5 py-3.5">Kontak</th>
              <th class="px-5 py-3.5">Pesan Masuk</th>
              <th class="px-5 py-3.5">Balasan Bot / Admin</th>
              <th class="px-5 py-3.5">Penangan</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% if (logs && logs.length > 0) { %>
              <% logs.forEach(function(log) { %>
                <tr class="hover:bg-gray-50/80 transition-colors">
                  <td class="px-5 py-4 text-xs font-mono text-gray-500 whitespace-nowrap">
                    <%= log.created_at %>
                  </td>
                  <td class="px-5 py-4 font-mono text-xs font-bold text-gray-800 whitespace-nowrap">
                    <%= log.contact %>
                  </td>
                  <td class="px-5 py-4 text-xs text-gray-900 font-medium max-w-xs">
                    <%= log.message_in || '-' %>
                  </td>
                  <td class="px-5 py-4 text-xs text-gray-600 max-w-sm">
                    <%= log.message_out || '-' %>
                  </td>
                  <td class="px-5 py-4">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold uppercase
                      <%= log.handled_by === 'human' ? 'bg-amber-100 text-amber-800' : 'bg-blue-100 text-blue-800' %>">
                      <%= log.handled_by === 'human' ? '👤 Handover' : '🤖 AI' %>
                    </span>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="5" class="px-5 py-8 text-center text-gray-400 text-sm">
                  <%= filterContact ? 'Tidak ditemukan riwayat chat untuk kontak tersebut.' : 'Belum ada riwayat percakapan yang terekam.' %>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Modal: Konfirmasi Kosongkan Riwayat Chat -->
  <div x-show="showClearModal" x-cloak class="fixed inset-0 z-50 overflow-y-auto bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-sm w-full p-6 space-y-4" @click.away="showClearModal = false">
      <div class="w-12 h-12 rounded-full bg-red-100 text-red-600 flex items-center justify-center mx-auto text-2xl font-bold">
        ⚠️
      </div>
      <div class="text-center">
        <h3 class="text-base font-bold text-gray-900">Kosongkan Riwayat Chat?</h3>
        <p class="text-xs text-gray-500 mt-1">Seluruh catatan log percakapan akan dihapus permanen dari database lokal.</p>
      </div>
      <form action="/dashboard/chat-logs/clear" method="POST" class="flex justify-center space-x-3 pt-2">
        <button @click="showClearModal = false" type="button" class="px-4 py-2 text-xs font-semibold text-gray-600 hover:bg-gray-100 rounded-lg">
          Batal
        </button>
        <button type="submit" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-xs font-semibold rounded-lg shadow-sm">
          Ya, Kosongkan
        </button>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
