<%- include('../partials/header') %>

<div class="flex-1 flex flex-col md:flex-row min-h-screen bg-[#F7F7F8]" x-data="{ showClearModal: false }">
  <!-- Sidebar -->
  <%- include('../partials/sidebar', { activeMenu: 'chat-logs', config, pendingHandoverCount }) %>

  <!-- Main Content Panel -->
  <main class="flex-1 p-6 md:p-10 max-w-5xl bg-white md:border-r border-[#E4E4E7] min-h-screen overflow-y-auto space-y-6">
    <!-- Header & Actions -->
    <div class="pb-6 border-b border-[#E4E4E7] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-[#18181B]">Chat Logs</h1>
        <p class="text-xs md:text-sm text-[#71717A] mt-1">Riwayat percakapan masuk dari pelanggan dan respons yang dihasilkan oleh AI bot.</p>
      </div>

      <% if (logs && logs.length > 0) { %>
        <button @click="showClearModal = true" type="button"
                class="px-4 py-1.5 rounded-full border border-[#E4E4E7] bg-white hover:bg-red-50 text-xs font-medium text-red-600 transition-colors flex items-center space-x-1.5 self-start sm:self-auto">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
            <polyline points="3 6 5 6 21 6"></polyline>
            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          </svg>
          <span>Kosongkan Riwayat</span>
        </button>
      <% } %>
    </div>

    <!-- Search & Filter Form -->
    <form action="/dashboard/chat-logs" method="GET" class="p-4 rounded-2xl border border-[#E4E4E7] bg-[#F7F7F8] flex flex-col sm:flex-row gap-2.5">
      <div class="relative flex-1">
        <input type="text" name="contact" value="<%= filterContact || '' %>" placeholder="Cari nomor kontak (contoh: 62812...)"
               class="w-full px-3.5 py-2 rounded-xl border border-[#E4E4E7] bg-white text-xs text-[#18181B] focus:outline-none focus:border-[#18181B] transition-colors">
      </div>
      <button type="submit" 
              class="px-5 py-2 rounded-full bg-[#18181B] hover:bg-[#27272A] text-white text-xs font-medium transition-colors">
        Filter
      </button>
      <% if (filterContact) { %>
        <a href="/dashboard/chat-logs" 
           class="px-4 py-2 rounded-full border border-[#E4E4E7] bg-white hover:bg-[#F4F4F5] text-xs font-medium text-[#71717A] text-center transition-colors">
          Reset
        </a>
      <% } %>
    </form>

    <!-- Active Paused Notice -->
    <% if (typeof pausedMap !== 'undefined' && Object.keys(pausedMap).length > 0) { %>
      <div class="p-4 rounded-2xl bg-[#F4F4F5] border border-[#E4E4E7] text-xs text-[#18181B] flex items-center justify-between">
        <div>
          <span class="font-medium text-[#18181B]">Terdapat <%= Object.keys(pausedMap).length %> kontak dalam status dijeda (Smart Mute).</span>
          <p class="text-[11px] text-[#71717A] mt-0.5">Bot tidak akan membalas kontak-kontak ini agar Anda dapat melakukan obrolan manual di WhatsApp.</p>
        </div>
      </div>
    <% } %>

    <!-- Logs Table -->
    <div class="border border-[#E4E4E7] rounded-2xl overflow-hidden bg-white">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-[#18181B]">
          <thead class="bg-[#F7F7F8] border-b border-[#E4E4E7] text-[11px] font-semibold text-[#71717A] uppercase tracking-wider">
            <tr>
              <th class="px-5 py-3.5">Waktu</th>
              <th class="px-5 py-3.5">Kontak</th>
              <th class="px-5 py-3.5">Pesan Masuk</th>
              <th class="px-5 py-3.5">Balasan Bot</th>
              <th class="px-5 py-3.5">Penangan</th>
              <th class="px-5 py-3.5 text-right">Kontrol</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#E4E4E7]">
            <% if (logs && logs.length > 0) { %>
              <% logs.forEach(function(log) { 
                 const isPaused = pausedMap && pausedMap[log.contact];
              %>
                <tr class="hover:bg-[#F7F7F8] transition-colors">
                  <td class="px-5 py-3.5 text-[#71717A] font-mono text-[11px] whitespace-nowrap">
                    <%= log.created_at %>
                  </td>
                  <td class="px-5 py-3.5 font-medium text-[#18181B] font-mono whitespace-nowrap">
                    <%= log.contact %>
                  </td>
                  <td class="px-5 py-3.5 text-[#18181B] max-w-xs">
                    <%= log.message_in || '-' %>
                  </td>
                  <td class="px-5 py-3.5 text-[#71717A] max-w-sm">
                    <%= log.message_out || '-' %>
                  </td>
                  <td class="px-5 py-3.5 whitespace-nowrap">
                    <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-medium bg-[#F4F4F5] text-[#18181B]">
                      <%= log.handled_by === 'human' ? 'Manual' : 'AI' %>
                    </span>
                  </td>
                  <td class="px-5 py-3.5 text-right whitespace-nowrap">
                    <% if (isPaused) { %>
                      <div class="flex items-center justify-end space-x-2">
                        <span class="text-[10px] text-red-600 font-medium">Dijeda</span>
                        <form action="/dashboard/chat-logs/resume" method="POST" class="inline">
                          <input type="hidden" name="contact" value="<%= log.contact %>">
                          <button type="submit" 
                                  class="px-3 py-1 rounded-full bg-[#18181B] text-white text-[11px] font-medium transition-colors">
                            Aktifkan
                          </button>
                        </form>
                      </div>
                    <% } else { %>
                      <form action="/dashboard/chat-logs/pause" method="POST" class="inline">
                        <input type="hidden" name="contact" value="<%= log.contact %>">
                        <input type="hidden" name="hours" value="2">
                        <button type="submit" 
                                class="px-3 py-1 rounded-full border border-[#E4E4E7] bg-white hover:bg-[#F4F4F5] text-[#71717A] hover:text-[#18181B] text-[11px] font-medium transition-colors">
                          Jeda 2 Jam
                        </button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="6" class="px-5 py-12 text-center text-[#71717A]">
                  <%= filterContact ? 'Tidak ada riwayat chat untuk nomor kontak ini.' : 'Belum ada percakapan terekam.' %>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <!-- Modal: Clear Logs Confirmation -->
  <div x-show="showClearModal" x-cloak class="fixed inset-0 z-50 overflow-y-auto bg-black/40 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-xl max-w-xs w-full p-6 space-y-4 text-center border border-[#E4E4E7]" @click.away="showClearModal = false">
      <div class="w-10 h-10 rounded-full bg-red-100 text-red-600 flex items-center justify-center mx-auto">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <polyline points="3 6 5 6 21 6"></polyline>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
        </svg>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-[#18181B]">Kosongkan Riwayat?</h3>
        <p class="text-xs text-[#71717A] mt-1">Seluruh log percakapan akan dihapus secara permanen.</p>
      </div>
      <form action="/dashboard/chat-logs/clear" method="POST" class="flex justify-center gap-2 pt-2">
        <button @click="showClearModal = false" type="button" 
                class="px-4 py-1.5 rounded-full border border-[#E4E4E7] bg-white hover:bg-[#F4F4F5] text-xs font-medium text-[#18181B]">
          Batal
        </button>
        <button type="submit" 
                class="px-4 py-1.5 rounded-full bg-red-600 hover:bg-red-700 text-white text-xs font-medium">
          Ya, Kosongkan
        </button>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
