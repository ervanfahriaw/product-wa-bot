<%- include('../partials/header') %>

<div class="flex-1 flex flex-col md:flex-row min-h-screen bg-[#F7F7F8]">
  <!-- Sidebar -->
  <%- include('../partials/sidebar', { activeMenu: 'handover-inbox', config, pendingHandoverCount }) %>

  <!-- Main Content Panel -->
  <main class="flex-1 p-6 md:p-10 max-w-5xl bg-white md:border-r border-[#E4E4E7] min-h-screen overflow-y-auto space-y-6">
    <!-- Header & Status Filter -->
    <div class="pb-6 border-b border-[#E4E4E7] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center space-x-2.5">
          <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-[#18181B]">Inbox Handover</h1>
          <% if (typeof pendingHandoverCount !== 'undefined' && pendingHandoverCount > 0) { %>
            <span class="px-2.5 py-0.5 text-xs font-semibold bg-[#DC2626] text-white rounded-full">
              <%= pendingHandoverCount %> Menunggu
            </span>
          <% } %>
        </div>
        <p class="text-xs md:text-sm text-[#71717A] mt-1">Daftar kontak yang membutuhkan respon manual dari pemilik toko (nego harga atau komplain).</p>
      </div>

      <!-- Filter Pills -->
      <div class="inline-flex p-1 bg-[#F4F4F5] rounded-full border border-[#E4E4E7] self-start sm:self-auto">
        <a href="/dashboard/handover-inbox?filter=pending" 
           class="px-3.5 py-1.5 text-xs font-medium rounded-full transition-all <%= currentFilter === 'pending' ? 'bg-[#18181B] text-white shadow-sm' : 'text-[#71717A] hover:text-[#18181B]' %>">
          Menunggu
        </a>
        <a href="/dashboard/handover-inbox?filter=resolved" 
           class="px-3.5 py-1.5 text-xs font-medium rounded-full transition-all <%= currentFilter === 'resolved' ? 'bg-[#18181B] text-white shadow-sm' : 'text-[#71717A] hover:text-[#18181B]' %>">
          Selesai
        </a>
        <a href="/dashboard/handover-inbox?filter=all" 
           class="px-3.5 py-1.5 text-xs font-medium rounded-full transition-all <%= currentFilter === 'all' ? 'bg-[#18181B] text-white shadow-sm' : 'text-[#71717A] hover:text-[#18181B]' %>">
          Semua
        </a>
      </div>
    </div>

    <!-- Handover Tickets List -->
    <div class="space-y-3.5">
      <% if (handovers && handovers.length > 0) { %>
        <% handovers.forEach(function(item) { %>
          <% 
            const cleanPhone = (item.contact || '').replace(/[^0-9]/g, '');
            const isPending = item.status === 'pending';
          %>
          <div class="p-5 rounded-2xl border border-[#E4E4E7] bg-white transition-colors space-y-3">
            <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
              <div class="space-y-2.5 flex-1">
                <div class="flex flex-wrap items-center gap-2 text-xs">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-medium
                    <%= isPending ? 'bg-red-50 text-red-800' : 'bg-[#F4F4F5] text-[#71717A]' %>">
                    <span class="w-1.5 h-1.5 rounded-full <%= isPending ? 'bg-red-500' : 'bg-emerald-500' %> mr-1.5"></span>
                    <%= isPending ? 'Perlu Ditangani' : 'Selesai' %>
                  </span>
                  
                  <span class="font-medium text-[#18181B]">
                    <%= item.contact %>
                  </span>

                  <span class="text-[#71717A]">
                    <%= new Date(item.created_at).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) %>
                  </span>
                </div>

                <div class="bg-[#F7F7F8] border border-[#E4E4E7] rounded-xl p-3 text-xs">
                  <span class="text-[#71717A] block text-[10px] uppercase font-semibold tracking-wider mb-1">Pesan Pelanggan</span>
                  <p class="font-medium text-[#18181B]">"<%= item.trigger_message %>"</p>
                </div>

                <p class="text-xs text-[#71717A]">
                  <span class="font-medium text-[#18181B]">Alasan:</span> <%= item.reason || 'Nego Harga / Kebutuhan Owner' %>
                </p>
              </div>

              <!-- Action Pill Buttons -->
              <div class="flex flex-wrap items-center gap-2 self-start md:self-auto">
                <a href="https://web.whatsapp.com/send?phone=<%= cleanPhone %>" target="_blank"
                   class="px-3.5 py-1.5 rounded-full bg-[#18181B] hover:bg-[#27272A] text-white text-xs font-medium transition-colors flex items-center space-x-1.5">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                  </svg>
                  <span>Buka di WhatsApp</span>
                </a>

                <form action="/dashboard/chat-logs/resume" method="POST" class="inline">
                  <input type="hidden" name="contact" value="<%= item.contact %>">
                  <button type="submit" 
                          class="px-3.5 py-1.5 rounded-full border border-[#E4E4E7] bg-white hover:bg-[#F4F4F5] text-xs font-medium text-[#18181B] transition-colors">
                    Aktifkan Bot
                  </button>
                </form>

                <% if (isPending) { %>
                  <form action="/dashboard/handover-inbox/<%= item.id %>/resolve" method="POST" class="inline">
                    <button type="submit" 
                            class="px-3.5 py-1.5 rounded-full border border-[#E4E4E7] bg-white hover:bg-[#F4F4F5] text-xs font-medium text-emerald-700 transition-colors">
                      Tandai Selesai
                    </button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="p-12 text-center text-[#71717A] border border-[#E4E4E7] rounded-2xl bg-white space-y-2">
          <svg class="w-8 h-8 text-[#71717A] mx-auto mb-1" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <p class="text-sm font-semibold text-[#18181B]">Tidak ada antrean pesan manual</p>
          <p class="text-xs text-[#71717A]">Semua obrolan pelanggan saat ini terlayani secara otomatis oleh bot.</p>
        </div>
      <% } %>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
